    "check": "astro check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^24.19.2",
    "miniflare": "5.20261118.0-beta",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  }
}
