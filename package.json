{
  "name": "judgeip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JudgeIP.com — IP 归属、网络类型、威胁与代理情报、泄露与分流检测工具箱",
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types scripts/build-reputation.ts && astro build",
    "preview": "wrangler dev",
