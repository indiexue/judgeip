// Local-only configuration. Never use this file for deployment.
{
  "name": "judgeip-rankings-local",
  "main": "./dist/server/entry.mjs",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": ["/assets/data/ipsum*", "/assets/data/ranges-*"]
  },
  "vars": { "PUBLIC_SITE_URL": "https://judgeip.com" },
  "d1_databases": [{
    "binding": "RANKINGS_DB",
    "database_name": "judgeip-rankings-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "./migrations"
  }]
}
