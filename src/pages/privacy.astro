---
import IpcxLayout from "../layouts/IpcxLayout.astro";
import zhHtml from "../snippets/privacy.html?raw";
import enHtml from "../snippets/en/privacy.html?raw";
import { getLang, pick } from "../lib/i18n";

const lang = getLang(Astro.locals);

const html = pick(lang, zhHtml, enHtml);
---

<IpcxLayout
  title={pick(lang, '隐私政策 · JudgeIP', 'Privacy policy · JudgeIP')}
  description={pick(lang, 'JudgeIP 隐私政策与数据处理说明。', 'JudgeIP privacy policy: what data is processed and how.')}
  canonicalPath="/privacy"
  bodyClass="page-privacy"
  currentLabel={pick(lang, '隐私政策', 'Privacy policy')}
  activeNav="/privacy"
  extraCss={[]}
  extraJs={[]}
>
  <Fragment set:html={html} />
</IpcxLayout>
