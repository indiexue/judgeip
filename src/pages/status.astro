---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { getLiveServiceStatuses } from '../lib/status-agg';
import { getLang } from '../lib/i18n';

const lang = getLang(Astro.locals);
const en = lang === 'en';
const t = (zh: string, en: string) => (lang === 'en' ? en : zh);
const snap = await getLiveServiceStatuses(lang);
const hasIssues = snap.badCount > 0;
---

<IpcxLayout
  title={t('服务状态 — ChatGPT、Claude、GitHub、Cloudflare 等是否故障 · JudgeIP', 'Service status: is ChatGPT, Claude, GitHub or Cloudflare down · JudgeIP')}
  description={t('汇总主流 AI 服务、云平台与开发工具官方状态页的运行状态。', 'Official status of major AI services, cloud platforms and developer tools in one place.')}
  canonicalPath="/status"
  bodyClass="page-status"
  currentLabel={t('服务状态', 'Service status')}
  activeNav="/status"
  extraCss={['/assets/css/status.css']}
>
  <section class="hero">
    <h1 class="hero__title">{t('服务状态', 'Service status')}</h1>
    <p class="hero__lede">{en ? `Official status of ${snap.total} common services. When something won't open, check here whether the service itself is down.` : `汇总 ${snap.total} 个常用服务的官方运行状态，打不开时先看是不是对方出了故障。`}</p>
  </section>

  <div class="status" id="status">
    <div class={`verdict ${hasIssues ? 'is-warn' : 'is-good'}`}>
      <span class="verdict__dot" aria-hidden="true"></span>
      <div class="verdict__body">
        <p class="verdict__title">
          {hasIssues ? (en ? `${snap.badCount} services have issues` : `${snap.badCount} 个服务存在故障或异常`) : (en ? 'No reported issues' : '没有服务报告故障')}
        </p>
        <p class="verdict__note">
          {hasIssues ? (
            <>
              {snap.badItems.map((b, idx) => (
                <>
                  {idx > 0 && t('、', ', ')}
                  <a class="status__jump" href={`#${b.id}`}>{b.name}</a>{t('（', ' (')}{b.tagText}{t('）', ')')}
                </>
              ))}
              {en ? `; ${snap.okCount} others operational. While a service is down, switching networks or proxy nodes won't help; wait for it to recover.` : `；其余 ${snap.okCount} 个运行正常。对方故障时换网络、换节点都没用，只能等它恢复。`}
            </>
          ) : (
            en ? `None of the ${snap.total} services report an outage on their official status pages${snap.mutedCount ? ` (${snap.mutedCount} could not be read)` : ''}.` : `${snap.total} 个服务的官方状态页都没有报告故障${snap.mutedCount ? `（其中 ${snap.mutedCount} 个没能读取）` : ''}。`
          )}
        </p>
      </div>
    </div>

    <dl class="stsum">
      <div class={`stsum__item stsum__item--ok${snap.okCount === 0 ? ' is-zero' : ''}`}>
        <dt class="stsum__label">{t('正常', 'Operational')}</dt>
        <dd class="stsum__num mono">{snap.okCount}</dd>
      </div>
      <div class={`stsum__item stsum__item--bad${snap.badCount === 0 ? ' is-zero' : ''}`}>
        <dt class="stsum__label">{t('故障', 'Issues')}</dt>
        <dd class="stsum__num mono">{snap.badCount}</dd>
      </div>
      <div class={`stsum__item stsum__item--maint${snap.maintCount === 0 ? ' is-zero' : ''}`}>
        <dt class="stsum__label">{t('维护中', 'Maintenance')}</dt>
        <dd class="stsum__num mono">{snap.maintCount}</dd>
      </div>
      <div class={`stsum__item stsum__item--muted${snap.mutedCount === 0 ? ' is-zero' : ''}`}>
        <dt class="stsum__label">{t('暂无数据', 'No data')}</dt>
        <dd class="stsum__num mono">{snap.mutedCount}</dd>
      </div>
    </dl>
    <p class="stsum__time">
      {t('数据取自各服务商官方状态页（缓存 5 分钟）· 点击服务名打开官方状态页', 'Data from each provider\'s official status page (cached 5 minutes) · Click a name to open its status page')}
    </p>

    <div class="groups">
      {snap.groups.map((grp) => (
        <section class="group" id={grp.id}>
          <h2 class="group__title">
            {grp.title}<span class="stgroup__count">{grp.items.length}</span>
          </h2>
          <div class="rows">
            {grp.items.map((svc) => (
              <div class={`svc svc--${svc.tone}`} id={svc.id}>
                <div class="svc__id">
                  <span class="svc__mark" aria-hidden="true">
                    {svc.mark}
                    <img class="favicon" src={`https://favicon.is/${svc.faviconDomain}`} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-favicon />
                  </span>
                  <a class="svc__name" href={svc.pageUrl} target="_blank" rel="noopener external">{svc.name}</a>
                </div>
                <div class="svc__note">{svc.note}</div>
                <div class="svc__state">
                  <span class={`tag tag--${svc.tone}`}>{svc.tagText}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</IpcxLayout>
