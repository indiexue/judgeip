---
import IpcxLayout from "../layouts/IpcxLayout.astro";
import zhHtml from "../snippets/terms.html?raw";
import enHtml from "../snippets/en/terms.html?raw";
import { getLang, pick } from "../lib/i18n";

const lang = getLang(Astro.locals);

const html = pick(lang, zhHtml, enHtml);
---

<IpcxLayout
  title={pick(lang, '服务条款 · JudgeIP', 'Terms of service · JudgeIP')}
  description={pick(lang, 'JudgeIP 服务使用条款与免责声明。', 'JudgeIP terms of service.')}
  canonicalPath="/terms"
  bodyClass="page-terms"
  currentLabel={pick(lang, '服务条款', 'Terms of service')}
  activeNav="/terms"
  extraCss={[]}
  extraJs={[]}
>
  <Fragment set:html={html} />
</IpcxLayout>
