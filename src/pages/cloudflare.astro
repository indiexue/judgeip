---
import IpcxLayout from "../layouts/IpcxLayout.astro";
import zhHtml from "../snippets/cloudflare.html?raw";
import enHtml from "../snippets/en/cloudflare.html?raw";
import { getLang, pick } from "../lib/i18n";
import { extractVisitorIp } from "../lib/ip-utils";

const lang = getLang(Astro.locals);

const visitorIp = extractVisitorIp(Astro.request);
const html = pick(lang, zhHtml, enHtml).replaceAll("__VISITOR_IP__", visitorIp);
---

<IpcxLayout
  title={pick(lang, 'Cloudflare 节点检测 — 你命中了哪个 Cloudflare 机房 · JudgeIP', 'Cloudflare edge check: node, bot check and network tiers · JudgeIP')}
  description={pick(lang, '检测你当前命中的 Cloudflare 边缘机房、协议、HTTP/3、ECH 与 WARP 状态。', 'Shows which Cloudflare node you hit, whether you pass Turnstile automatically, and how Cloudflare network tiers compare on your connection.')}
  canonicalPath="/cloudflare"
  bodyClass="page-cloudflare"
  currentLabel={pick(lang, 'Cloudflare', 'Cloudflare edge')}
  activeNav="/cloudflare"
  extraCss={["/assets/css/cloudflare.css"]}
  extraJs={["/assets/js/probe.js", "/assets/js/cloudflare.js", "/assets/js/cfturnstile.js"]}
>
  <Fragment set:html={html} />
</IpcxLayout>
