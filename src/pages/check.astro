---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { extractVisitorIp } from '../lib/ip-utils';
import { getLang, pick } from '../lib/i18n';

const lang = getLang(Astro.locals);
const t = (zh: string, en: string) => pick(lang, zh, en);
const visitorIp = extractVisitorIp(Astro.request);
const dimensions = [
  ['purity', '1. IP 类型与信誉', '1. IP type and reputation'],
  ['webrtc', '2. WebRTC 出口', '2. WebRTC exit'],
  ['dns', '3. DNS 解析地区', '3. DNS resolver region'],
  ['consistency', '4. 时区与语言', '4. Timezone and language'],
  ['stealth', '5. 浏览器自动化标记', '5. Browser automation flags'],
  ['ai', '6. AI 服务连通性', '6. AI service connectivity'],
];
---

<IpcxLayout
  title={t('网络与浏览器环境体检 · JudgeIP', 'Network and browser checkup · JudgeIP')}
  description={t('检查 IP 类型、WebRTC 出口、DNS 解析地区、时区语言、浏览器自动化标记与 AI 服务连通性。', 'Check IP type, WebRTC exits, DNS resolver regions, timezone, language, browser automation flags and AI connectivity.')}
  canonicalPath="/check"
  bodyClass="page-check"
  currentLabel={t('环境体检', 'Checkup')}
  activeNav="/check"
  extraJs={['/assets/js/probe.js', '/assets/js/check.js']}
>
  <section class="hero">
    <h1 class="hero__title">{t('网络与浏览器环境体检', 'Network and browser checkup')}</h1>
    <p class="hero__lede">{t('一起检查 IP、WebRTC、DNS 和浏览器设置，帮助定位出口与环境差异。', 'Check your IP, WebRTC, DNS and browser settings to spot differences between exits and local settings.')}</p>
  </section>

  <div class="probe" id="envcheck" data-visible-ip={visitorIp}>
    <div class="probe__bar">
      <button class="probe__run" type="button" data-check-run>{t('重新检测', 'Run again')}</button>
      <span class="probe__hint" data-check-progress>{t('页面加载后自动开始检测…', 'Checks start automatically after the page loads…')}</span>
    </div>
    <div class="verdict" data-check-verdict hidden>
      <span class="verdict__dot" aria-hidden="true"></span>
      <div class="verdict__body">
        <p class="verdict__title" data-check-verdict-title></p>
        <p class="verdict__note" data-check-verdict-note></p>
      </div>
    </div>
    <div class="groups">
      <section class="group">
        <h2 class="group__title">{t('检测概览', 'Overview')}</h2>
        <div class="rows">
          <div class="row">
            <span class="row__label">{t('当前出口 IP', 'Current exit IP')}</span>
            <span class="row__value" data-check-ip><span class="mono">{visitorIp}</span></span>
          </div>
          <div class="row">
            <span class="row__label">{t('参考评分', 'Indicative score')}</span>
            <span class="row__value" data-check-score><span class="dim">{t('计算中…', 'Calculating…')}</span></span>
          </div>
          <div class="row">
            <span class="row__label">{t('通过项目', 'Checks passed')}</span>
            <span class="row__value" data-check-passed><span class="dim">{t('计算中…', 'Calculating…')}</span></span>
          </div>
        </div>
      </section>
      <section class="group">
        <h2 class="group__title">{t('检测明细', 'Check details')}</h2>
        <div class="rows">
          {dimensions.map(([key, zh, en]) => (
            <div class="row" data-dim={key}>
              <span class="row__label">{t(zh, en)}</span>
              <span class="row__value" data-dim-val><span class="dim">{t('待检测', 'Pending')}</span></span>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
  <article class="prose">
    <h2>{t('如何理解结果', 'How to read the results')}</h2>
    <p>{t('同一台设备访问不同服务时，可能使用不同的 IP、DNS 或 UDP 出口。时区和首选语言也不一定与出口地区相同，这些差异并不都代表泄露或配置错误。', 'Different services may see different IP, DNS or UDP exits from the same device. Your timezone and preferred language may also differ from the exit region; these differences do not always indicate a leak or a configuration error.')}</p>
    <p>{t('本页只提供排查线索。评分来自有限的检测规则，不代表第三方平台的风控结论，也不能保证账号安全或服务可用。请求失败或未捕获到数据时，请使用对应的单项工具复查。', 'This page provides troubleshooting clues only. The score uses a limited set of rules, does not represent any platform’s risk assessment and cannot guarantee account safety or service access. If a request fails or returns no data, use the individual tools to investigate further.')}</p>
  </article>
</IpcxLayout>
