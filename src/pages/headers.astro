---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { extractVisitorIp } from '../lib/ip-utils';

const visitorIp = extractVisitorIp(Astro.request);
const cf = (Astro.request as Request & { cf?: Record<string, unknown> }).cf || {};
const ua = Astro.request.headers.get('user-agent') || '';

function parseUserAgent(uaStr: string) {
  let browser = '未知浏览器';
  if (/Edg\/([\d.]+)/.test(uaStr)) browser = `Microsoft Edge ${RegExp.$1}`;
  else if (/OPR\/([\d.]+)/.test(uaStr)) browser = `Opera ${RegExp.$1}`;
  else if (/Chrome\/([\d.]+)/.test(uaStr) && !/Chromium/.test(uaStr)) browser = `Google Chrome ${RegExp.$1}`;
  else if (/Firefox\/([\d.]+)/.test(uaStr)) browser = `Mozilla Firefox ${RegExp.$1}`;
  else if (/Version\/([\d.]+).*Safari/.test(uaStr)) browser = `Apple Safari ${RegExp.$1}`;
  else if (/curl\/([\d.]+)/i.test(uaStr)) browser = `curl ${RegExp.$1}`;

  let os = '未知系统';
  if (/Windows NT 10\.0/.test(uaStr)) os = 'Windows 10 / 11';
  else if (/Mac OS X ([\d_]+)/.test(uaStr)) os = `macOS ${RegExp.$1.replace(/_/g, '.')}`;
  else if (/Android ([\d.]+)/.test(uaStr)) os = `Android ${RegExp.$1}`;
  else if (/iPhone OS ([\d_]+)/.test(uaStr)) os = `iOS ${RegExp.$1.replace(/_/g, '.')}`;
  else if (/Linux/.test(uaStr)) os = 'Linux';

  const isBot = /(bot|spider|crawl|headless|python-requests|curl|wget|go-http-client)/i.test(uaStr);
  return { browser, os, isBot };
}

const uaParsed = parseUserAgent(ua);

const PROXY_LEAK_HEADERS = new Set([
  'via',
  'forwarded',
  'x-forwarded-for',
  'x-real-ip',
  'proxy-connection',
  'x-proxy-id',
  'client-ip',
]);

// Exclude internal Cloudflare edge injection headers when judging user-side proxy leaks
const CF_INTERNAL_HEADERS = new Set([
  'cf-connecting-ip',
  'cf-ipcountry',
  'cf-ray',
  'cf-visitor',
  'cf-ew-via',
  'cdn-loop',
  'x-forwarded-proto',
]);

const allHeaders: Array<{ name: string; value: string; isProxyLeak: boolean }> = [];
Astro.request.headers.forEach((value, key) => {
  const lower = key.toLowerCase();
  const isLeak = PROXY_LEAK_HEADERS.has(lower) && !CF_INTERNAL_HEADERS.has(lower) && lower !== 'x-forwarded-for';
  allHeaders.push({ name: key, value, isProxyLeak: isLeak });
});
allHeaders.sort((a, b) => a.name.localeCompare(b.name));
---

<IpcxLayout
  title="HTTP 请求头与 User-Agent 检测 — 查看服务器收到的真实标头 · JudgeIP"
  description="实时回显你的浏览器发往服务器的全部 HTTP 请求头、TLS 协议、Client Hints 与 User-Agent 解析结果，排查透明代理标头泄露。"
  canonicalPath="/headers"
  bodyClass="page-headers"
  currentLabel="HTTP 请求头"
  activeNav="/headers"
>
  <section class="hero">
    <h1 class="hero__title">HTTP 请求头与 UA 解析</h1>
    <p class="hero__lede">原样展示服务器从你这次连接中收到的全部 HTTP 标头、边缘握手协议与浏览器身份特征。</p>
  </section>

  <div class="groups">
    <section class="group">
      <h2 class="group__title">连接与 User-Agent 解析摘要</h2>
      <div class="rows">
        <div class="row">
          <span class="row__label">来源 IP</span>
          <span class="row__value"><span class="mono">{visitorIp}</span></span>
        </div>
        <div class="row">
          <span class="row__label">浏览器识别</span>
          <span class="row__value">
            <span>{uaParsed.browser}</span>
            {uaParsed.isBot && <span class="badge badge--amber" style="margin-left:8px;">脚本 / 爬虫特征</span>}
          </span>
        </div>
        <div class="row">
          <span class="row__label">操作系统</span>
          <span class="row__value">{uaParsed.os}</span>
        </div>
        <div class="row">
          <span class="row__label">传输与加密协议</span>
          <span class="row__value">
            <span class="mono">
              {(cf.httpProtocol as string) || 'HTTP/2'} · {(cf.tlsVersion as string) || 'TLS 1.3'}
              {cf.colo ? ` · 节点 ${cf.colo}` : ''}
            </span>
          </span>
        </div>
        <div class="row">
          <span class="row__label">Accept-Language</span>
          <span class="row__value"><span class="mono">{Astro.request.headers.get('accept-language') || '未发送'}</span></span>
        </div>
      </div>
    </section>

    <section class="group">
      <h2 class="group__title">全部原始 HTTP 请求头 ({allHeaders.length} 项)</h2>
      <div class="rows">
        {allHeaders.map((h) => (
          <div class="row">
            <span class="row__label">
              <span class="mono">{h.name}</span>
              {h.isProxyLeak && <span class="tag tag--leak" style="margin-left:6px;">代理标头</span>}
            </span>
            <span class="row__value"><span class="mono">{h.value}</span></span>
          </div>
        ))}
      </div>
    </section>
  </div>

  <article class="prose">
    <h2>请求头会泄露哪些隐私与代理破绽</h2>
    <ul>
      <li><strong>透明代理标头（<span class="mono">Via</span> / <span class="mono">Forwarded</span>）</strong>：劣质 HTTP 代理会在转发请求时自动塞入客户端原始 IP 或代理软件名称，目标网站无需任何探测即可识破代理。高匿代理（Elite Proxy）与现代加密隧道不会附加此类标头。</li>
      <li><strong>语言偏好（<span class="mono">Accept-Language</span>）</strong>：每一次网页请求都会原样携带浏览器语言列表。挂着美国住宅代理却发送 <span class="mono">zh-CN,zh;q=0.9</span> 是最常见的前后端不一致特征之一。</li>
      <li><strong>客户端提示（<span class="mono">Sec-CH-UA-*</span>）</strong>：Chromium 系浏览器通过 Client Hints 发送品牌版本与平台架构，即使插件修改了传统 <span class="mono">User-Agent</span> 字符串，忘了同步改 Client Hints 也会当场穿帮。</li>
    </ul>
  </article>
</IpcxLayout>
