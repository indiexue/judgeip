---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { extractVisitorIp } from '../lib/ip-utils';
import { getLang } from '../lib/i18n';
const lang = getLang(Astro.locals);
const t = (zh: string, en: string) => (lang === 'en' ? en : zh);


const visitorIp = extractVisitorIp(Astro.request);
const cf = (Astro.request as Request & { cf?: Record<string, unknown> }).cf || {};
const ua = Astro.request.headers.get('user-agent') || '';

function parseUserAgent(uaStr: string) {
  let browser = t('未知浏览器', 'Unknown browser');
  if (/Edg\/([\d.]+)/.test(uaStr)) browser = `Microsoft Edge ${RegExp.$1}`;
  else if (/OPR\/([\d.]+)/.test(uaStr)) browser = `Opera ${RegExp.$1}`;
  else if (/Chrome\/([\d.]+)/.test(uaStr) && !/Chromium/.test(uaStr)) browser = `Google Chrome ${RegExp.$1}`;
  else if (/Firefox\/([\d.]+)/.test(uaStr)) browser = `Mozilla Firefox ${RegExp.$1}`;
  else if (/Version\/([\d.]+).*Safari/.test(uaStr)) browser = `Apple Safari ${RegExp.$1}`;
  else if (/curl\/([\d.]+)/i.test(uaStr)) browser = `curl ${RegExp.$1}`;

  let os = t('未知系统', 'Unknown OS');
  if (/Windows NT 10\.0/.test(uaStr)) os = 'Windows 10 / 11';
  else if (/Mac OS X ([\d_]+)/.test(uaStr)) os = `macOS ${RegExp.$1.replace(/_/g, '.')}`;
  else if (/Android ([\d.]+)/.test(uaStr)) os = `Android ${RegExp.$1}`;
  else if (/iPhone OS ([\d_]+)/.test(uaStr)) os = `iOS ${RegExp.$1.replace(/_/g, '.')}`;
  else if (/Linux/.test(uaStr)) os = 'Linux';

  const isBot = /(bot|spider|crawl|headless|python-requests|curl|wget|go-http-client)/i.test(uaStr);
  return { browser, os, isBot };
}

const uaParsed = parseUserAgent(ua);

const PROXY_LEAK_HEADERS = new Set([
  'via',
  'forwarded',
  'x-forwarded-for',
  'x-real-ip',
  'proxy-connection',
  'x-proxy-id',
  'client-ip',
]);

// Exclude internal Cloudflare edge injection headers when judging user-side proxy leaks
const CF_INTERNAL_HEADERS = new Set([
  'cf-connecting-ip',
  'cf-ipcountry',
  'cf-ray',
  'cf-visitor',
  'cf-ew-via',
  'cdn-loop',
  'x-forwarded-proto',
]);

const allHeaders: Array<{ name: string; value: string; isProxyLeak: boolean }> = [];
Astro.request.headers.forEach((value, key) => {
  const lower = key.toLowerCase();
  const isLeak = PROXY_LEAK_HEADERS.has(lower) && !CF_INTERNAL_HEADERS.has(lower) && lower !== 'x-forwarded-for';
  allHeaders.push({ name: key, value, isProxyLeak: isLeak });
});
allHeaders.sort((a, b) => a.name.localeCompare(b.name));
---

<IpcxLayout
  title={t('HTTP 请求头与 User-Agent 检测 — 查看服务器收到的请求头 · JudgeIP', 'HTTP headers and User-Agent: see the headers the server receives · JudgeIP')}
  description={t('显示你的浏览器发给服务器的全部 HTTP 请求头、TLS 版本、Client Hints 与 User-Agent 解析结果，用来排查代理加的请求头。', 'Shows every HTTP request header your browser sends, the TLS version, Client Hints and the parsed User-Agent, to spot headers added by a proxy.')}
  canonicalPath="/headers"
  bodyClass="page-headers"
  currentLabel={t('HTTP 请求头', 'HTTP headers')}
  activeNav="/headers"
>
  <section class="hero">
    <h1 class="hero__title">{t('HTTP 请求头与 UA 解析', 'HTTP headers and UA')}</h1>
    <p class="hero__lede">{t('原样显示服务器从这次连接收到的全部 HTTP 请求头、协议版本与浏览器标识。', 'Every HTTP request header the server received on this connection, as is, plus the protocol version and browser identity.')}</p>
  </section>

  <div class="groups">
    <section class="group">
      <h2 class="group__title">{t('连接与 User-Agent 解析摘要', 'Connection and User-Agent summary')}</h2>
      <div class="rows">
        <div class="row">
          <span class="row__label">{t('来源 IP', 'Source IP')}</span>
          <span class="row__value"><span class="mono">{visitorIp}</span></span>
        </div>
        <div class="row">
          <span class="row__label">{t('浏览器识别', 'Browser')}</span>
          <span class="row__value">
            <span>{uaParsed.browser}</span>
            {uaParsed.isBot && <span class="badge badge--amber" style="margin-left:8px;">{t('脚本 / 爬虫特征', 'Script / bot traits')}</span>}
          </span>
        </div>
        <div class="row">
          <span class="row__label">{t('操作系统', 'Operating system')}</span>
          <span class="row__value">{uaParsed.os}</span>
        </div>
        <div class="row">
          <span class="row__label">{t('传输与加密协议', 'Transport and encryption')}</span>
          <span class="row__value">
            <span class="mono">
              {(cf.httpProtocol as string) || 'HTTP/2'} · {(cf.tlsVersion as string) || 'TLS 1.3'}
              {cf.colo ? (lang === 'en' ? ` · colo ${cf.colo}` : ` · 节点 ${cf.colo}`) : ''}
            </span>
          </span>
        </div>
        <div class="row">
          <span class="row__label">Accept-Language</span>
          <span class="row__value"><span class="mono">{Astro.request.headers.get('accept-language') || t('未发送', 'Not sent')}</span></span>
        </div>
      </div>
    </section>

    <section class="group">
      <h2 class="group__title">{t('全部原始 HTTP 请求头 (', 'All raw HTTP request headers (')}{allHeaders.length}{t(' 项)', ')')}</h2>
      <div class="rows">
        {allHeaders.map((h) => (
          <div class="row">
            <span class="row__label">
              <span class="mono">{h.name}</span>
              {h.isProxyLeak && <span class="tag tag--leak" style="margin-left:6px;">{t('代理标头', 'Proxy header')}</span>}
            </span>
            <span class="row__value"><span class="mono">{h.value}</span></span>
          </div>
        ))}
      </div>
    </section>
  </div>

  <article class="prose">
    {lang === 'en' ? (
      <>
        <h2>What request headers can reveal</h2>
        <ul>
          <li><strong>Proxy headers (<span class="mono">Via</span> / <span class="mono">Forwarded</span>)</strong>: some HTTP proxies add the client's original IP or the proxy software name when forwarding a request, so the site can tell a proxy is in use without any probing. High-anonymity (elite) proxies and encrypted tunnels don't add these headers.</li>
          <li><strong>Language preference (<span class="mono">Accept-Language</span>)</strong>: every request carries the browser's language list. A US residential proxy sending <span class="mono">zh-CN,zh;q=0.9</span> is one of the most common mismatches sites look for.</li>
          <li><strong>Client Hints (<span class="mono">Sec-CH-UA-*</span>)</strong>: Chromium-based browsers send the brand, version and platform through Client Hints. If an extension changes the <span class="mono">User-Agent</span> string but not the Client Hints, the two won't match.</li>
        </ul>
      </>
    ) : (
      <>
        <h2>请求头会暴露什么</h2>
        <ul>
          <li><strong>代理请求头（<span class="mono">Via</span> / <span class="mono">Forwarded</span>）</strong>：部分 HTTP 代理转发请求时会加上客户端的原始 IP 或代理软件名称，网站不用做任何探测就能知道你在用代理。高匿代理（Elite Proxy）和加密隧道不会加这类请求头。</li>
          <li><strong>语言偏好（<span class="mono">Accept-Language</span>）</strong>：每个请求都会带上浏览器的语言列表。用着美国住宅代理却发送 <span class="mono">zh-CN,zh;q=0.9</span>，是网站最常检查的不一致之一。</li>
          <li><strong>客户端提示（<span class="mono">Sec-CH-UA-*</span>）</strong>：Chromium 系浏览器通过 Client Hints 发送品牌、版本与平台。扩展只改了 <span class="mono">User-Agent</span> 字符串、没有同步改 Client Hints，两者就会对不上。</li>
        </ul>
      </>
    )}
  </article>
</IpcxLayout>
