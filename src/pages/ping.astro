---
import IpcxLayout from "../layouts/IpcxLayout.astro";
import zhHtml from "../snippets/ping.html?raw";
import enHtml from "../snippets/en/ping.html?raw";
import { getLang, pick } from "../lib/i18n";

const lang = getLang(Astro.locals);

const html = pick(lang, zhHtml, enHtml);
---

<IpcxLayout
  title={pick(lang, '全球 Ping 测试 — 从世界各地探针测试 IP 与域名延迟 · JudgeIP', 'Global ping: test IP and domain latency from 13 regions · JudgeIP')}
  description={pick(lang, '从全球 13 个地区同时 Ping 指定 IP 或域名，对比各地最小/平均/最大延迟与丢包率。', 'Ping an IP or domain from 13 regions at once and compare min / avg / max latency and packet loss.')}
  canonicalPath="/ping"
  bodyClass="page-ping"
  currentLabel={pick(lang, '全球 Ping', 'Global ping')}
  activeNav="/ping"
  extraCss={["/assets/css/ping.css"]}
  extraJs={["/assets/js/probe.js", "/assets/js/ping.js"]}
>
  <Fragment set:html={html} />
</IpcxLayout>
