---
import IpcxLayout from '../../layouts/IpcxLayout.astro';
import IpcxHomeContent from '../../components/IpcxHomeContent.astro';
import { extractVisitorIp, parseIp } from '../../lib/ip-utils';
import { lookupIpFull } from '../../lib/ipcx-lookup';
import { localizeLookup } from '../../lib/lookup-en';
import { getLang, localePath, pick } from '../../lib/i18n';

const lang = getLang(Astro.locals);

const rawIp = Astro.params.ip || '';
const parsed = parseIp(rawIp);
if (!parsed) {
  return Astro.redirect(localePath('/', lang));
}

const visitorIp = extractVisitorIp(Astro.request);
const cfMeta = (Astro.request as Request & { cf?: Record<string, unknown> }).cf || null;
const isVisitor = parsed.normalized === visitorIp;
const info = localizeLookup(await lookupIpFull(parsed.normalized, cfMeta, isVisitor, null, { visitorIp }), lang);

const title = pick(lang, `${info.ip} 的 IP 归属与威胁情报查询 · JudgeIP`, `${info.ip}: owner, network type and threat data · JudgeIP`);
const description = pick(lang, `${info.ip} 的 IP 归属地、ISP、ASN、网络类型、威胁情报与代理情报查询结果。`, `Location, ISP, ASN, network type, threat and proxy data for ${info.ip}.`);
---

<IpcxLayout
  noindex
  title={title}
  description={description}
  canonicalPath={`/ip/${info.ip}`}
  bodyClass="page-home"
  currentLabel={pick(lang, 'IP 检测', 'IP check')}
  activeNav="/"
  extraJs={['/assets/js/ip-search.js', '/assets/js/stats.js']}
>
  <IpcxHomeContent info={info} isSelf={false} queryValue={info.ip} />
</IpcxLayout>
