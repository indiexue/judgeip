---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import IpcxHomeContent from '../components/IpcxHomeContent.astro';
import { extractVisitorIp, parseIp } from '../lib/ip-utils';
import { lookupIpFull } from '../lib/ipcx-lookup';
import { localizeLookup } from '../lib/lookup-en';
import { getLang, pick } from '../lib/i18n';

const lang = getLang(Astro.locals);

const visitorIp = extractVisitorIp(Astro.request);
const cfMeta = (Astro.request as Request & { cf?: Record<string, unknown> }).cf || null;

let rawQuery = '';
if (Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    rawQuery = String(fd.get('ip') || '').trim();
  } catch {
    rawQuery = '';
  }
} else {
  rawQuery = (Astro.url.searchParams.get('ip') || Astro.url.searchParams.get('q') || '').trim();
}

let targetIp = visitorIp;
let errorMsg = '';
if (rawQuery) {
  const parsed = parseIp(rawQuery);
  if (parsed) {
    targetIp = parsed.normalized;
  } else {
    errorMsg = pick(lang, `「${rawQuery.slice(0, 60)}」不是有效的 IPv4 或 IPv6 地址，已显示你的本机 IP。`, `"${rawQuery.slice(0, 60)}" is not a valid IPv4 or IPv6 address. Showing your own IP instead.`);
  }
}

const isSelf = targetIp === visitorIp && !rawQuery;
const info = localizeLookup(await lookupIpFull(targetIp, cfMeta, targetIp === visitorIp, null, { visitorIp }), lang);

// 标题和分享文案固定，不带访客或抓取方的 IP
const title = pick(lang, 'JudgeIP · 本机 IP 查询：归属地、网络类型与风险证据', 'JudgeIP · What is my IP: location, network type and risk evidence');
const description = pick(lang, '查看本机或任意 IP 的归属地、ISP、ASN、网络类型、代理标记与黑名单记录，每项结论附数据来源。', 'Check the location, ISP, ASN, network type, proxy flags and blocklist records of your IP or any IP, with the source behind each result.');
---

<IpcxLayout
  title={title}
  description={description}
  canonicalPath="/"
  bodyClass="page-home"
  currentLabel={pick(lang, 'IP 检测', 'IP check')}
  activeNav="/"
  extraCss={['/assets/css/connectivity.css']}
  extraJs={isSelf ? ['/assets/js/probe.js', '/assets/js/ip-search.js', '/assets/js/homenet.js', '/assets/js/connectivity.js'] : ['/assets/js/ip-search.js']}
>
  <IpcxHomeContent info={info} isSelf={isSelf} queryValue={rawQuery && !errorMsg ? info.ip : rawQuery} errorMsg={errorMsg} />
</IpcxLayout>
