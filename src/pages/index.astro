---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import IpcxHomeContent from '../components/IpcxHomeContent.astro';
import { extractVisitorIp, parseIp } from '../lib/ip-utils';
import { lookupIpFull } from '../lib/ipcx-lookup';

const visitorIp = extractVisitorIp(Astro.request);
const cfMeta = (Astro.request as Request & { cf?: Record<string, unknown> }).cf || null;

let rawQuery = '';
if (Astro.request.method === 'POST') {
  try {
    const fd = await Astro.request.formData();
    rawQuery = String(fd.get('ip') || '').trim();
  } catch {
    rawQuery = '';
  }
} else {
  rawQuery = (Astro.url.searchParams.get('ip') || Astro.url.searchParams.get('q') || '').trim();
}

let targetIp = visitorIp;
let errorMsg = '';
if (rawQuery) {
  const parsed = parseIp(rawQuery);
  if (parsed) {
    targetIp = parsed.normalized;
  } else {
    errorMsg = `「${rawQuery.slice(0, 60)}」不是有效的 IPv4 或 IPv6 地址，已显示你的本机 IP。`;
  }
}

const isSelf = targetIp === visitorIp && !rawQuery;
const info = await lookupIpFull(targetIp, cfMeta, targetIp === visitorIp);

const title = `${info.ip} 的 IP 归属与威胁情报查询 · JudgeIP`;
const description = `${info.ip} 的 IP 归属地、ISP、ASN、网络类型、威胁情报与代理情报查询结果。`;
---

<IpcxLayout
  title={title}
  description={description}
  canonicalPath="/"
  bodyClass="page-home"
  currentLabel="IP 检测"
  activeNav="/"
  extraCss={['/assets/css/connectivity.css']}
  extraJs={isSelf ? ['/assets/js/probe.js', '/assets/js/homenet.js', '/assets/js/connectivity.js'] : []}
>
  <IpcxHomeContent info={info} isSelf={isSelf} queryValue={rawQuery && !errorMsg ? info.ip : rawQuery} errorMsg={errorMsg} />
</IpcxLayout>
