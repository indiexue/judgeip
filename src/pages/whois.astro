---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { queryRdap } from '../lib/rdap-lookup';
import { localizeRdap } from '../lib/rdap-en';
import { getLang, localePath, pick } from '../lib/i18n';

const lang = getLang(Astro.locals);
const t = (zh: string, en: string) => pick(lang, zh, en);
const href = (path: string) => localePath(path, lang);
const rawQ = (Astro.url.searchParams.get('q') || '').trim();
const result = rawQ ? localizeRdap(await queryRdap(rawQ), lang) : null;

const title = result?.ok
  ? t(`${result.displayName} 的 Whois / RDAP 注册信息 · JudgeIP`, `${result.displayName}: Whois / RDAP registration data · JudgeIP`)
  : t('Whois 查询 — 域名、IP、ASN 注册信息 · JudgeIP', 'Whois lookup — domain, IP and ASN registration data · JudgeIP');
const description = t('查询域名、IP、IP 段或 ASN 的注册信息，数据来自注册局与 RIR 的 RDAP 服务。', 'Look up domain, IP range and ASN registration data from registry and RIR RDAP services.');
const commonStatuses = [
  ['正常', 'OK', 'ok', 'green', '没有状态限制，可正常解析、续费、修改和转移。', 'No status restrictions on resolution, renewal, updates or transfer.'],
  ['注册商转移锁', 'Registrar transfer lock', 'clientTransferProhibited', 'gray', '禁止转移到其他注册商，是常见的安全设置。', 'Transfers to another registrar are locked, a common security setting.'],
  ['注册商更新锁', 'Registrar update lock', 'clientUpdateProhibited', 'gray', '禁止修改联系人、DNS 服务器等注册信息。', 'Changes to contacts, nameservers and other registration data are locked.'],
  ['注册商删除锁', 'Registrar delete lock', 'clientDeleteProhibited', 'gray', '禁止删除域名。', 'Domain deletion is locked.'],
  ['暂停解析', 'Resolution on hold', 'clientHold', 'amber', '注册商暂停了 DNS 解析，网站和邮箱可能无法使用。', 'The registrar has suspended DNS resolution; website and email service may be unavailable.'],
  ['赎回期', 'Redemption period', 'redemptionPeriod', 'amber', '域名过期删除后，原持有人通常有约 30 天可付费恢复。', 'After deletion, the previous registrant usually has about 30 days to restore the domain for a fee.'],
];
---

<IpcxLayout
  title={title}
  description={description}
  canonicalPath="/whois"
  bodyClass="page-whois"
  currentLabel={t('Whois 查询', 'Whois lookup')}
  activeNav="/whois"
  extraCss={['/assets/css/whois.css']}
>
  <section class="hero">
    <h1 class="hero__title">{t('Whois / RDAP 查询', 'Whois / RDAP lookup')}</h1>
    <p class="hero__lede">{t('查询域名、IP、IP 段或 ASN 的注册信息。', 'Look up registration data for a domain, IP range or ASN.')}</p>
  </section>

  <form class="query whois-query" method="get" action={href('/whois')} role="search">
    <div class="query__line">
      <span class="query__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m20 20-4.9-4.9"></path>
        </svg>
      </span>
      <input
        class="query__input mono"
        type="text"
        name="q"
        value={rawQ}
        placeholder="example.com / 1.1.1.1 / AS13335"
        maxlength="300"
        inputmode="url"
        enterkeyhint="search"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label={t('要查询的域名、IP 地址、IP 段或 ASN', 'Domain, IP address, IP range or ASN')}
      />
      <button class="query__submit" type="submit">{t('查询', 'Look up')}</button>
    </div>

    <p class="whois-examples">
      <span class="whois-examples__label">{t('试试', 'Try')}</span>
      <a class="whois-examples__item" href={href('/whois?q=judgeip.com')} rel="nofollow">judgeip.com</a>
      <a class="whois-examples__item" href={href('/whois?q=qq.com')} rel="nofollow">qq.com</a>
      <a class="whois-examples__item" href={href('/whois?q=1.1.1.1')} rel="nofollow">1.1.1.1</a>
      <a class="whois-examples__item" href={href('/whois?q=2400%3A3200%3A%3A1')} rel="nofollow">2400:3200::1</a>
      <a class="whois-examples__item" href={href('/whois?q=AS13335')} rel="nofollow">AS13335</a>
    </p>

    {result && !result.ok && (
      <p class="notice" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7.5v5.2M12 16.3v.2"></path>
        </svg>
        <span>{result.error}</span>
      </p>
    )}
  </form>

  {result && result.ok && (
    <div class="whois" id="result">
      <section class="whois-card" aria-labelledby="whois-name">
        <div class="whois-card__head">
          <span class="whois-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
            </svg>
          </span>
          <div class="whois-card__id">
            <span class="whois-card__eyebrow">{result.eyebrow}</span>
            <h2 class="whois-card__name mono" id="whois-name">{result.displayName}</h2>
            {result.subline && <p class="whois-card__sub">{result.subline}</p>}
          </div>
        </div>

        {result.badges.length > 0 && (
          <div class="whois-card__badges">
            {result.badges.map((b) => (
              <span class={`badge badge--${b.tone}`}>{b.text}</span>
            ))}
          </div>
        )}

        {result.life && (
          <div class={`whois-life whois-life--${result.life.tone}`}>
            <div class="whois-life__labels">
              <span>{t('注册', 'Registered')} <span class="mono">{result.life.regDate}</span></span>
              <span>{t('到期', 'Expires')} <span class="mono">{result.life.expDate}</span></span>
            </div>
            <svg class="whois-life__bar" viewBox="0 0 100 8" preserveAspectRatio="none" role="img" aria-label={result.life.caption}>
              <rect class="whois-life__track" x="0" y="0" width="100" height="8" rx="4"></rect>
              {result.life.pct > 0 && (
                <rect class="whois-life__fill" x="0" y="0" width={result.life.pct} height="8" rx="4"></rect>
              )}
            </svg>
            <p class="whois-life__caption">{result.life.caption}</p>
          </div>
        )}
      </section>

      <p class="whois-source">
        {t('数据来源', 'Source')} <span class="mono">{result.sourceHost}</span> · RDAP · {t('实时查询', 'Live lookup')}
      </p>

      <div class="groups">
        {result.statuses.length > 0 && (
          <section class="group">
            <h2 class="group__title">
              {t('状态标记', 'Status')}<span class="whois-count">{result.statuses.length} {t('项', 'items')}</span>
            </h2>
            <div class="rows">
              {result.statuses.map((st) => (
                <div class="whois-st">
                  <div class="whois-st__name">
                    <span class={`badge badge--${st.tone}`}>{st.label}</span>
                    <span class="whois-st__code mono">{st.code}</span>
                  </div>
                  <div class="whois-st__note">{st.note}</div>
                </div>
              ))}
            </div>
          </section>
        )}

        {result.dates.length > 0 && (
          <section class="group">
            <h2 class="group__title">{t('关键日期', 'Key dates')}</h2>
            <div class="rows">
              {result.dates.map((d) => (
                <div class="row">
                  <span class="row__label">{d.label}</span>
                  <span class="row__value">
                    <span class="mono">{d.date}</span>
                    {d.hint && <span class="whois-hint">{d.hint}</span>}
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}

        {result.nameservers.length > 0 && (
          <section class="group">
            <h2 class="group__title">
              {t('DNS 服务器', 'Nameservers')}<span class="whois-count">{result.nameservers.length} {t('台', 'servers')}</span>
            </h2>
            <div class="rows">
              {result.nameservers.map((ns) => (
                <div class="whois-ns mono">{ns}</div>
              ))}
            </div>
          </section>
        )}

        {result.details.length > 0 && (
          <section class="group">
            <h2 class="group__title">{t('注册信息', 'Registration details')}</h2>
            <div class="rows">
              {result.details.map((row) => (
                <div class="row">
                  <span class="row__label">{row.label}</span>
                  <span class="row__value">
                    {row.badgeTone ? (
                      <span class={`badge badge--${row.badgeTone}`}>{row.value}</span>
                    ) : row.isMail ? (
                      <a class="whois-mail mono" href={`mailto:${row.value}`}>{row.value}</a>
                    ) : (
                      <span class={row.mono ? 'mono' : ''}>{row.value}</span>
                    )}
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <details class="whois-raw">
        <summary class="whois-raw__summary">
          {t('原始 RDAP 数据（JSON）', 'Raw RDAP data (JSON)')} <span class="whois-raw__size mono">{result.rawSizeKb}</span>
        </summary>
        <pre class="whois-raw__body mono">{result.rawJson}</pre>
      </details>
    </div>
  )}

  <article class="prose">
    <h2>{t('什么是 Whois 与 RDAP', 'What are Whois and RDAP?')}</h2>
    <p>{t('注册记录包含域名、IP 段或 ASN 的持有机构、注册日期和当前状态等信息。域名记录由各顶级域注册局保存；IP 与 ASN 记录由 APNIC、ARIN、RIPE NCC、LACNIC 和 AFRINIC 等区域互联网注册机构保存。', 'Registration records describe a domain, IP range or ASN, including its organization, registration dates and status. TLD registries maintain domain records; regional Internet registries such as APNIC, ARIN, RIPE NCC, LACNIC and AFRINIC maintain IP and ASN records.')}</p>
    <p>{t('RDAP（注册数据访问协议）是 Whois 的后继协议，使用 HTTPS 和结构化 JSON 返回注册信息。部分联系人信息可能因隐私政策而被隐藏。', 'RDAP (Registration Data Access Protocol) succeeds Whois, returning structured registration data over HTTPS. Some contact information may be redacted for privacy.')}</p>
    <h2>{t('常见域名状态码', 'Common domain status codes')}</h2>
    <ul class="whois-codes">
      {commonStatuses.map(([zh, en, code, tone, zhNote, enNote]) => (
        <li>
          <span class="whois-codes__head"><span class={`badge badge--${tone}`}>{t(zh, en)}</span> <span class="mono">{code}</span></span>
          <span class="whois-codes__note">{t(zhNote, enNote)}</span>
        </li>
      ))}
    </ul>
  </article>
</IpcxLayout>
