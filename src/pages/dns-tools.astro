---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { parseIp } from '../lib/ip-utils';
import { checkIpv4Dnsbl } from '../lib/ipcx-lookup';
import { getLang, localePath } from '../lib/i18n';
const lang = getLang(Astro.locals);
const t = (zh: string, en: string) => (lang === 'en' ? en : zh);
const lp = (path: string) => localePath(path, lang);


const rawQ = (Astro.url.searchParams.get('q') || '').trim();
const queryTarget = rawQ.replace(/^https?:\/\//i, '').replace(/\/.*$/, '');

interface DnsRecordItem {
  type: string;
  name: string;
  ttl: number;
  data: string;
}

const RECORD_TYPES = ['A', 'AAAA', 'CNAME', 'MX', 'TXT', 'NS'];

async function queryDohType(name: string, rtype: string): Promise<DnsRecordItem[]> {
  const ctl = new AbortController();
  const timer = setTimeout(() => ctl.abort(), 3000);
  try {
    const res = await fetch(`https://1.1.1.1/dns-query?name=${encodeURIComponent(name)}&type=${rtype}`, {
      signal: ctl.signal,
      headers: { Accept: 'application/dns-json' },
    });
    clearTimeout(timer);
    if (!res.ok) return [];
    const json = (await res.json()) as {
      Answer?: Array<{ name?: string; type?: number; TTL?: number; data?: string }>;
    };
    const TYPE_CODE_MAP: Record<number, string> = {
      1: 'A',
      28: 'AAAA',
      5: 'CNAME',
      15: 'MX',
      16: 'TXT',
      2: 'NS',
      12: 'PTR',
    };
    return (json.Answer || []).map((a) => ({
      type: TYPE_CODE_MAP[a.type || 0] || rtype,
      name: String(a.name || name).replace(/\.$/, ''),
      ttl: Number(a.TTL || 0),
      data: String(a.data || ''),
    }));
  } catch {
    clearTimeout(timer);
    return [];
  }
}

let mode: 'idle' | 'ip' | 'domain' | 'invalid' = 'idle';
let records: DnsRecordItem[] = [];
let dnsblHits: string[] = [];
let ptrDomain = '';

if (queryTarget) {
  const parsedIp = parseIp(queryTarget);
  if (parsedIp && parsedIp.version === 4) {
    mode = 'ip';
    ptrDomain = parsedIp.normalized.split('.').reverse().join('.') + '.in-addr.arpa';
    const [ptrRes, blRes] = await Promise.all([
      queryDohType(ptrDomain, 'PTR'),
      checkIpv4Dnsbl(parsedIp.normalized),
    ]);
    records = ptrRes;
    dnsblHits = blRes;
  } else if (/^[a-z0-9.-]+\.[a-z]{2,}$/i.test(queryTarget)) {
    mode = 'domain';
    const all = await Promise.all(RECORD_TYPES.map((t) => queryDohType(queryTarget, t)));
    records = all.flat();
    // Deduplicate identical CNAMEs returned across sub-queries
    const seen = new Set<string>();
    records = records.filter((r) => {
      const k = `${r.type}|${r.name}|${r.data}`;
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
  } else {
    mode = 'invalid';
  }
}
---

<IpcxLayout
  title={t('DNS 查询与黑名单 (DNSBL) 检测 — A/AAAA/MX/TXT/NS/PTR · JudgeIP', 'DNS lookup and blocklist (DNSBL) check: A/AAAA/MX/TXT/NS/PTR · JudgeIP')}
  description={t('在线查询域名的 A、AAAA、CNAME、MX、TXT、NS 解析记录，或检测 IPv4 地址的反向解析 PTR 与邮件垃圾黑名单 (DNSBL)。', 'Look up a domain\'s A, AAAA, CNAME, MX, TXT and NS records, or check an IPv4 address\'s reverse DNS (PTR) and spam blocklists (DNSBL).')}
  canonicalPath="/dns-tools"
  bodyClass="page-dnstools"
  currentLabel={t('DNS 工具', 'DNS tools')}
  activeNav="/dns-tools"
  extraCss={['/assets/css/whois.css']}
>
  <section class="hero">
    <h1 class="hero__title">{t('DNS 查询与 DNSBL 黑名单', 'DNS lookup and DNSBL')}</h1>
    <p class="hero__lede">{t('输入域名，一次查出 A / AAAA / MX / TXT / NS 记录；输入 IPv4 地址，查 PTR 与 4 个常用垃圾邮件黑名单。', 'Enter a domain to get its A / AAAA / MX / TXT / NS records at once; enter an IPv4 address to check its PTR and 4 common spam blocklists.')}</p>
  </section>

  <form class="query whois-query" method="get" action={lp('/dns-tools')} role="search">
    <div class="query__line">
      <span class="query__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m20 20-4.9-4.9"></path>
        </svg>
      </span>
      <input
        class="query__input mono"
        type="text"
        name="q"
        value={queryTarget}
        placeholder="judgeip.com / openai.com / 8.8.8.8"
        autocomplete="off"
        spellcheck="false"
        aria-label={t('要查询的域名或 IPv4', 'Domain or IPv4 to look up')}
      />
      <button class="query__submit" type="submit">{t('查询', 'Look up')}</button>
    </div>

    <p class="whois-examples">
      <span class="whois-examples__label">{t('试试', 'Try')}</span>
      <a class="whois-examples__item" href={lp('/dns-tools?q=judgeip.com')} rel="nofollow">judgeip.com</a>
      <a class="whois-examples__item" href={lp('/dns-tools?q=openai.com')} rel="nofollow">openai.com</a>
      <a class="whois-examples__item" href={lp('/dns-tools?q=gmail.com')} rel="nofollow">gmail.com</a>
      <a class="whois-examples__item" href={lp('/dns-tools?q=8.8.8.8')} rel="nofollow">8.8.8.8</a>
      <a class="whois-examples__item" href={lp('/dns-tools?q=45.76.12.8')} rel="nofollow">45.76.12.8</a>
    </p>

    {mode === 'invalid' && (
      <p class="notice" role="alert">
        <span>{t('无法识别输入，请输入域名（如 openai.com）或 IPv4 地址（如 8.8.8.8）。', 'Unrecognized input. Enter a domain (such as openai.com) or an IPv4 address (such as 8.8.8.8).')}</span>
      </p>
    )}
  </form>

  {mode === 'domain' && (
    <div class="groups">
      <section class="group">
        <h2 class="group__title">
          {t('DNS 解析记录', 'DNS records')} ({queryTarget}) <span class="whois-count">{records.length}{t(' 条', '')}</span>
        </h2>
        <div class="rows">
          {records.length === 0 ? (
            <div class="row">
              <span class="row__label">{t('查询结果', 'Results')}</span>
              <span class="row__value"><span class="dim">{t('未查到公开 DNS 记录（域名不存在或未配置常见记录）。', 'No public DNS records found (the domain doesn\'t exist or has none of the common records).')}</span></span>
            </div>
          ) : (
            records.map((r) => (
              <div class="row">
                <span class="row__label">
                  <span class="badge badge--gray mono">{r.type}</span>
                  <span class="dim mono" style="margin-left:8px; font-size:12px;">TTL {r.ttl}s</span>
                </span>
                <span class="row__value"><span class="mono">{r.data}</span></span>
              </div>
            ))
          )}
        </div>
      </section>
    </div>
  )}

  {mode === 'ip' && (
    <div class="groups">
      <section class="group">
        <h2 class="group__title">{t('反向解析 (rDNS / PTR)', 'Reverse DNS (rDNS / PTR)')}</h2>
        <div class="rows">
          <div class="row">
            <span class="row__label">{t('反查区名', 'Reverse zone')}</span>
            <span class="row__value"><span class="mono">{ptrDomain}</span></span>
          </div>
          <div class="row">
            <span class="row__label">{t('PTR 主机名', 'PTR host name')}</span>
            <span class="row__value">
              {records.length > 0 ? (
                <span class="mono">{records.map((r) => r.data).join(', ')}</span>
              ) : (
                <span class="dim">{t('未设置反向解析记录', 'No reverse DNS record set')}</span>
              )}
            </span>
          </div>
        </div>
      </section>

      <section class="group">
        <h2 class="group__title">{t('DNSBL 黑名单检查', 'DNSBL check')}</h2>
        <div class="rows">
          {['SpamCop', 'DroneBL', 'Barracuda', 'UCEPROTECT'].map((blName) => {
            const hit = dnsblHits.includes(blName);
            return (
              <div class="row">
                <span class="row__label">{blName}</span>
                <span class="row__value">
                  <span class={`tag tag--${hit ? 'leak' : 'ok'}`}>{hit ? t('命中黑名单 (Listed)', 'Listed') : t('未收录 (Clean)', 'Not listed')}</span>
                </span>
              </div>
            );
          })}
        </div>
      </section>
    </div>
  )}

  <article class="prose">
    {lang === 'en' ? (
      <>
        <h2>About DoH lookups and DNSBL</h2>
        <p>
          Lookups are made from the server through Cloudflare's <span class="mono">1.1.1.1</span> DNS-over-HTTPS API, so the results aren't affected by your local ISP's DNS cache or tampering.
          For an IPv4 address, besides the <span class="mono">in-addr.arpa</span> reverse lookup, the address is checked against common spam and botnet blocklists (DNSBL) in parallel. A mail server or static residential proxy listed on any of them is more likely to have mail land in spam and to hit CAPTCHAs on sign-in.
        </p>
      </>
    ) : (
      <>
        <h2>关于 DoH 查询与 DNSBL</h2>
        <p>
          查询由服务端通过 Cloudflare <span class="mono">1.1.1.1</span> 的 DNS-over-HTTPS 接口发出，不受你本地运营商 DNS 缓存或劫持的影响。
          输入 IPv4 地址时，除了查 <span class="mono">in-addr.arpa</span> 反向解析，还会同时检查常用的垃圾邮件与僵尸网络黑名单（DNSBL）。发信服务器或静态住宅代理只要被其中一个收录，邮件就更容易进垃圾箱，登录时也更容易遇到验证码。
        </p>
      </>
    )}
  </article>
</IpcxLayout>
