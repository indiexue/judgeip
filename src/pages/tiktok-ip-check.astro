---
import BaseLayout from '../layouts/BaseLayout.astro';
import VerdictDashboard from '../components/VerdictDashboard.astro';
import { extractVisitorIp } from '../lib/ip-utils';
import { evaluateIpVerdict } from '../lib/verdict-engine';
import { detectLocale } from '../lib/i18n';
import { getEdgeEnv } from '../lib/edge-env';

const locale = detectLocale(Astro.url, Astro.request);
const visitorIp = extractVisitorIp(Astro.request);
const cfMeta = (Astro.request as Request & { cf?: Record<string, unknown> }).cf || null;
const report = await evaluateIpVerdict(visitorIp, {
  cfMetadata: cfMeta,
  isDirectVisitor: true,
  kvNamespace: getEdgeEnv().IP_CACHE,
});

const title =
  locale === 'zh'
    ? 'TikTok 网络环境与原生 IP 检测 | JudgeIP'
    : 'TikTok IP Check — Native ISP & Hosting Risk Lookup | JudgeIP';
const description =
  locale === 'zh'
    ? '检测当前 IP 是否为本地原生宽带，排查机房网段、广播 IP 与浏览器时区不一致问题。'
    : 'Check whether your IP belongs to a native residential ISP or datacenter range for TikTok account operations.';
const heading =
  locale === 'zh'
    ? 'TikTok 原生 IP 与网络环境检测'
    : 'TikTok Native IP & ISP Check';
---

<BaseLayout title={title} description={description} canonicalPath="/tiktok-ip-check" locale={locale}>
  <VerdictDashboard report={report} locale={locale} isVisitor={true} scenarioSubtitle={heading} />
</BaseLayout>
