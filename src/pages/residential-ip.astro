---
import ScenarioPage from '../components/ScenarioPage.astro';
import { getLang, localePath } from '../lib/i18n';
import { MANY_PORTS_THRESHOLD } from '../lib/score-rules';

const lang = getLang(Astro.locals);
const en = lang === 'en';
const t = (zh: string, enText: string) => (en ? enText : zh);
const href = (path: string) => localePath(path, lang);
---

<ScenarioPage
  id="residential-ip"
  title={t('住宅 IP 检测 - 查 IP 是住宅 IP 还是机房 IP - JudgeIP', 'Residential IP Check - Is an IP Residential or Data Center - JudgeIP')}
  description={t(
    '检测当前 IP 或任意 IP 是住宅 IP 还是机房 IP：看网络类型、代理标记、黑名单和开放端口。每一项的权重和得分都列在页面上。',
    'Check whether your IP or any IP is residential or data center: network type, proxy flags, blocklists and open ports. Every weight and point is listed on the page.',
  )}
  heading={t('住宅 IP 检测', 'Residential IP check')}
  lede={t(
    '住宅 IP 指宽带或移动运营商分给普通用户的地址。下面按四项打分，权重和每一项的依据都列出来。',
    'A residential IP is an address a broadband or mobile carrier hands to ordinary subscribers. It is scored on four items below, with the weight and basis of each listed.',
  )}
>
  <h2>{t('住宅 IP 和机房 IP', 'Residential and data center IPs')}</h2>
  <p>
    {t(
      '住宅 IP 属于家庭宽带或移动网络的运营商，机房 IP 属于云服务商和托管商。平台做风控时会按地址所属的 ASN 分类，机房地址上很少有真人用户，注册、支付、发帖更容易被拦或要求验证。',
      'Residential IPs belong to home broadband and mobile carriers; data center IPs belong to cloud and hosting providers. Platforms classify addresses by ASN in their risk checks. Few real users sit on data center addresses, so sign-ups, payments and posts from them are blocked or challenged more often.',
    )}
  </p>

  <h2>{t('四项权重的理由', 'Why these four weights')}</h2>
  <ul>
    <li>{t('住宅或移动网络，60 分。家庭宽带和移动网络都算通过；企业和教育网络不是住宅，也不是机房，拿一半；机房和 CDN 不得分，总分不会超过 40。', 'Residential or mobile network, 60 points. Home broadband and mobile networks both pass. Business and education networks are neither residential nor data center and get half. Data center and CDN addresses get nothing, so the total cannot exceed 40.')}</li>
    <li>{t('无代理标记，20 分。住宅代理的地址网络类型是住宅，但已经进了代理名单，平台看到的是代理。', 'No proxy flag, 20 points. A residential proxy address has a residential network type but is already on proxy lists, and platforms see a proxy.')}</li>
    <li>{t('无黑名单或威胁记录，10 分。被入侵的家用设备常被拿去发垃圾邮件或扫描，地址会进黑名单。', 'No blocklist or threat records, 10 points. Compromised home devices are often used for spam or scanning, which lands the address on blocklists.')}</li>
    <li>{t(`开放端口不超过 ${MANY_PORTS_THRESHOLD} 个，10 分。家用线路一般不对外开端口，开得多更像服务器。`, `No more than ${MANY_PORTS_THRESHOLD} open ports, 10 points. Home lines rarely expose ports; many open ports look like a server.`)}</li>
  </ul>
  <p>
    {t(
      '全部通过记为符合，总分低于 60 记为不符合，其余记为部分符合。有一项缺数据就不出总分；缺的项全算通过也到不了 60 时，仍记为不符合。',
      'All items passing counts as meeting it, a total under 60 as not meeting it, anything else as partly meeting it. No total is given when any item lacks data; when even a pass on every missing item would leave it under 60, the result is still "does not meet it".',
    )}
  </p>

  <h2>{t('局限', 'Limits')}</h2>
  <ul>
    <li>{t('网络类型按 ASN 和运营商名称归类。运营商既卖宽带又卖机房托管时，同一个 ASN 下两种地址都有，这里分不开。', 'Network type is classified from the ASN and operator name. When a carrier sells both broadband and colocation, one ASN holds both kinds of address and they cannot be told apart here.')}</li>
    <li>{t('没被标记的住宅代理查不出来。代理标记来自公开数据，新上线的代理池不一定在里面。', 'Unflagged residential proxies are not detected. Proxy flags come from public data, and a new proxy pool may not be in it yet.')}</li>
    <li>{t('端口和黑名单数据只覆盖 IPv4。IPv6 地址这两项缺数据，不出总分。', 'Port and blocklist data cover IPv4 only. For IPv6 addresses these two items have no data and no total is given.')}</li>
    <li>{t('住宅不等于原生。住宅地址也可能注册在别的国家，见原生 IP 检测。', 'Residential does not mean native. A residential address can be registered in another country; see the native IP check.')}</li>
  </ul>
  <p>
    <a href={href('/native-ip')}>{t('原生 IP 检测', 'Native IP check')}</a> · <a href={href('/tiktok-ip')}>{t('TikTok IP 检测', 'TikTok IP check')}</a> · <a href={href('/platforms')}>{t('平台检测', 'Platform check')}</a> · <a href={href('/scoring')}>{t('评分规则', 'Scoring rules')}</a>
  </p>
</ScenarioPage>
