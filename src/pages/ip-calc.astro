---
import IpcxLayout from '../layouts/IpcxLayout.astro';
import { ipv4ToInt, parseIp } from '../lib/ip-utils';

function intToIpv4(n: number): string {
  return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
}

function intToBinaryDots(n: number): string {
  return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255]
    .map((b) => b.toString(2).padStart(8, '0'))
    .join('.');
}

const rawQ = (Astro.url.searchParams.get('q') || '').trim() || '192.168.1.0/24';
let errorMsg = '';

interface V4Calc {
  kind: 'v4';
  cidr: string;
  ip: string;
  prefix: number;
  netmask: string;
  wildcard: string;
  network: string;
  broadcast: string;
  firstHost: string;
  lastHost: string;
  totalIps: string;
  usableHosts: string;
  binaryMask: string;
  isBogon: boolean;
  bogonNote: string;
}

interface V6Calc {
  kind: 'v6';
  cidr: string;
  expanded: string;
  networkPrefix: string;
  prefix: number;
  totalSubnets64: string;
  isBogon: boolean;
  bogonNote: string;
}

let calc: V4Calc | V6Calc | null = null;

const [addrPart, prefixPart] = rawQ.split('/');
const parsed = parseIp(addrPart);

if (!parsed) {
  errorMsg = `「${rawQ}」格式无效，请输入如 192.168.1.0/24、73.160.0.0/14 或 2606:4700::/32。`;
} else if (parsed.version === 4) {
  const prefix = prefixPart !== undefined && prefixPart !== '' ? Number(prefixPart) : 24;
  if (!Number.isInteger(prefix) || prefix < 0 || prefix > 32) {
    errorMsg = 'IPv4 掩码前缀长度必须在 0 到 32 之间。';
  } else {
    const ipInt = ipv4ToInt(parsed.normalized);
    const maskInt = prefix === 0 ? 0 : (~0 << (32 - prefix)) >>> 0;
    const wildInt = (~maskInt) >>> 0;
    const netInt = (ipInt & maskInt) >>> 0;
    const bcastInt = (netInt | wildInt) >>> 0;
    const total = Math.pow(2, 32 - prefix);
    const usable = prefix === 32 ? 1 : prefix === 31 ? 2 : Math.max(0, total - 2);
    const firstInt = prefix >= 31 ? netInt : (netInt + 1) >>> 0;
    const lastInt = prefix >= 31 ? bcastInt : (bcastInt - 1) >>> 0;

    calc = {
      kind: 'v4',
      cidr: `${intToIpv4(netInt)}/${prefix}`,
      ip: parsed.normalized,
      prefix,
      netmask: intToIpv4(maskInt),
      wildcard: intToIpv4(wildInt),
      network: intToIpv4(netInt),
      broadcast: intToIpv4(bcastInt),
      firstHost: intToIpv4(firstInt),
      lastHost: intToIpv4(lastInt),
      totalIps: total.toLocaleString('en-US'),
      usableHosts: usable.toLocaleString('en-US'),
      binaryMask: intToBinaryDots(maskInt),
      isBogon: parsed.isBogon,
      bogonNote: parsed.bogonReason || '公网可路由单播地址',
    };
  }
} else {
  const prefix = prefixPart !== undefined && prefixPart !== '' ? Number(prefixPart) : 64;
  if (!Number.isInteger(prefix) || prefix < 0 || prefix > 128) {
    errorMsg = 'IPv6 前缀长度必须在 0 到 128 之间。';
  } else {
    const halves = parsed.normalized.split('::');
    const head = halves[0] ? halves[0].split(':') : [];
    const tail = halves.length > 1 && halves[1] ? halves[1].split(':') : [];
    const fill = halves.length > 1 ? Array(8 - head.length - tail.length).fill('0000') : [];
    const groups = [...head, ...fill, ...tail].map((g) => g.padStart(4, '0'));
    const expanded = groups.join(':');
    const subnets64 = prefix <= 64 ? Math.pow(2, 64 - prefix).toLocaleString('en-US') : '小于单个 /64';

    calc = {
      kind: 'v6',
      cidr: `${parsed.normalized}/${prefix}`,
      expanded,
      networkPrefix: `/${prefix}`,
      prefix,
      totalSubnets64: subnets64,
      isBogon: parsed.isBogon,
      bogonNote: parsed.bogonReason || '公网可路由 IPv6 全局单播地址',
    };
  }
}
---

<IpcxLayout
  title="IP / CIDR 子网计算器 — 掩码、可用地址范围与网段换算 · JudgeIP"
  description="在线计算 IPv4 与 IPv6 CIDR 网段的子网掩码、反掩码、网络地址、广播地址、可用主机范围与二进制表示。"
  canonicalPath="/ip-calc"
  bodyClass="page-ipcalc"
  currentLabel="IP 计算器"
  activeNav="/ip-calc"
  extraCss={['/assets/css/whois.css']}
>
  <section class="hero">
    <h1 class="hero__title">IP / CIDR 子网计算器</h1>
    <p class="hero__lede">输入 IPv4 或 IPv6 地址与前缀长度，计算子网掩码、首尾可用主机与网段容量。</p>
  </section>

  <form class="query whois-query" method="get" action="/ip-calc" role="search">
    <div class="query__line">
      <span class="query__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m20 20-4.9-4.9"></path>
        </svg>
      </span>
      <input
        class="query__input mono"
        type="text"
        name="q"
        value={rawQ}
        placeholder="192.168.1.0/24 / 10.0.0.1/16 / 2606:4700::/32"
        autocomplete="off"
        spellcheck="false"
        aria-label="IP 或 CIDR 网段"
      />
      <button class="query__submit" type="submit">计算</button>
    </div>

    <p class="whois-examples">
      <span class="whois-examples__label">试试</span>
      <a class="whois-examples__item" href="/ip-calc?q=192.168.1.0/24" rel="nofollow">192.168.1.0/24</a>
      <a class="whois-examples__item" href="/ip-calc?q=10.24.0.0/16" rel="nofollow">10.24.0.0/16</a>
      <a class="whois-examples__item" href="/ip-calc?q=73.160.0.0/14" rel="nofollow">73.160.0.0/14</a>
      <a class="whois-examples__item" href="/ip-calc?q=172.16.10.5/28" rel="nofollow">172.16.10.5/28</a>
      <a class="whois-examples__item" href="/ip-calc?q=2606%3A4700%3A%3A/32" rel="nofollow">2606:4700::/32</a>
    </p>

    {errorMsg && (
      <p class="notice" role="alert">
        <span>{errorMsg}</span>
      </p>
    )}
  </form>

  {calc && calc.kind === 'v4' && (
    <div class="groups">
      <section class="group">
        <h2 class="group__title">IPv4 子网计算结果</h2>
        <div class="rows">
          <div class="row">
            <span class="row__label">规范 CIDR</span>
            <span class="row__value"><span class="mono">{calc.cidr}</span></span>
          </div>
          <div class="row">
            <span class="row__label">地址性质</span>
            <span class="row__value">
              <span class={`badge badge--${calc.isBogon ? 'gray' : 'green'}`}>{calc.bogonNote}</span>
            </span>
          </div>
          <div class="row">
            <span class="row__label">子网掩码</span>
            <span class="row__value"><span class="mono">{calc.netmask}</span> <span class="dim mono">(/{calc.prefix})</span></span>
          </div>
          <div class="row">
            <span class="row__label">反掩码 (Wildcard)</span>
            <span class="row__value"><span class="mono">{calc.wildcard}</span></span>
          </div>
          <div class="row">
            <span class="row__label">网络地址</span>
            <span class="row__value"><span class="mono">{calc.network}</span></span>
          </div>
          <div class="row">
            <span class="row__label">广播地址</span>
            <span class="row__value"><span class="mono">{calc.broadcast}</span></span>
          </div>
          <div class="row">
            <span class="row__label">可用主机范围</span>
            <span class="row__value"><span class="mono">{calc.firstHost} – {calc.lastHost}</span></span>
          </div>
          <div class="row">
            <span class="row__label">总地址数 / 可用主机数</span>
            <span class="row__value"><span class="mono">{calc.totalIps}</span> 总计 · <span class="mono">{calc.usableHosts}</span> 可分配</span>
          </div>
          <div class="row">
            <span class="row__label">二进制掩码</span>
            <span class="row__value"><span class="mono">{calc.binaryMask}</span></span>
          </div>
        </div>
      </section>
    </div>
  )}

  {calc && calc.kind === 'v6' && (
    <div class="groups">
      <section class="group">
        <h2 class="group__title">IPv6 前缀计算结果</h2>
        <div class="rows">
          <div class="row">
            <span class="row__label">输入前缀</span>
            <span class="row__value"><span class="mono">{calc.cidr}</span></span>
          </div>
          <div class="row">
            <span class="row__label">地址性质</span>
            <span class="row__value">
              <span class={`badge badge--${calc.isBogon ? 'gray' : 'green'}`}>{calc.bogonNote}</span>
            </span>
          </div>
          <div class="row">
            <span class="row__label">完整展开地址 (128-bit)</span>
            <span class="row__value"><span class="mono">{calc.expanded}</span></span>
          </div>
          <div class="row">
            <span class="row__label">包含标准 /64 子网数</span>
            <span class="row__value"><span class="mono">{calc.totalSubnets64}</span></span>
          </div>
        </div>
      </section>
    </div>
  )}

  <article class="prose">
    <h2>常用 IPv4 前缀速查表</h2>
    <ul>
      <li><span class="mono">/32</span>（掩码 <span class="mono">255.255.255.255</span>）：单台主机路由，共 1 个地址。</li>
      <li><span class="mono">/28</span>（掩码 <span class="mono">255.255.255.240</span>）：共 16 个地址，14 台可用主机（常见专线小段）。</li>
      <li><span class="mono">/24</span>（掩码 <span class="mono">255.255.255.0</span>）：标准 C 段，共 256 个地址，254 台可用主机（BGP 公网最小宣告粒度）。</li>
      <li><span class="mono">/16</span>（掩码 <span class="mono">255.255.0.0</span>）：标准 B 段，共 65,536 个地址。</li>
    </ul>
  </article>
</IpcxLayout>
