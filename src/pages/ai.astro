---
import IpcxLayout from "../layouts/IpcxLayout.astro";
import rawHtml from "../snippets/ai.html?raw";
import { extractVisitorIp } from "../lib/ip-utils";

const visitorIp = extractVisitorIp(Astro.request);
const html = rawHtml.replaceAll("__VISITOR_IP__", visitorIp);
---

<IpcxLayout
  title="AI 解锁检测 — ChatGPT、Claude、Gemini、Grok 能不能用 · JudgeIP"
  description="检测 ChatGPT、Claude、Gemini、Grok、Perplexity 等主流 AI 服务可达性与地区限制。"
  canonicalPath="/ai"
  bodyClass="page-ai"
  currentLabel="AI 解锁检测"
  activeNav="/ai"
  extraCss={["/assets/css/ai.css"]}
  extraJs={["/assets/js/probe.js", "/assets/js/ai.js"]}
>
  <Fragment set:html={html} />
</IpcxLayout>
