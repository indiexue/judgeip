---
import { UI_COPY, type Locale } from '../lib/i18n';
import type { IpVerdictReport, VerdictGrade, PlatformStatus } from '../lib/verdict-engine';

interface Props {
  report: IpVerdictReport;
  locale: Locale;
  isVisitor: boolean;
  scenarioSubtitle?: string;
}

const { report, locale, isVisitor, scenarioSubtitle } = Astro.props;
const t = UI_COPY[locale];
const basePrefix = locale === 'zh' ? '/zh' : '';

const gradeColorMap: Record<VerdictGrade, { ring: string; text: string; bg: string; glow: string; stroke: string }> = {
  S: {
    ring: 'border-emerald-400/35',
    text: 'text-emerald-400',
    bg: 'bg-emerald-500/12',
    glow: 'shadow-[0_0_40px_-12px_rgba(16,185,129,0.35)]',
    stroke: '#10b981',
  },
  A: {
    ring: 'border-teal-400/35',
    text: 'text-teal-300',
    bg: 'bg-teal-500/12',
    glow: 'shadow-[0_0_40px_-12px_rgba(45,212,191,0.3)]',
    stroke: '#2dd4bf',
  },
  B: {
    ring: 'border-amber-400/35',
    text: 'text-amber-300',
    bg: 'bg-amber-500/12',
    glow: 'shadow-[0_0_40px_-12px_rgba(251,191,36,0.3)]',
    stroke: '#fbbf24',
  },
  C: {
    ring: 'border-orange-500/40',
    text: 'text-orange-400',
    bg: 'bg-orange-500/12',
    glow: 'shadow-[0_0_40px_-12px_rgba(249,115,22,0.3)]',
    stroke: '#f97316',
  },
  D: {
    ring: 'border-rose-500/45',
    text: 'text-rose-400',
    bg: 'bg-rose-500/12',
    glow: 'shadow-[0_0_40px_-12px_rgba(244,63,94,0.35)]',
    stroke: '#f43f5e',
  },
};

const theme = gradeColorMap[report.grade];
const radius = 56;
const circumference = 2 * Math.PI * radius;
const dashOffset = circumference - (report.score / 100) * circumference;

function platformBadgeStyle(st: PlatformStatus) {
  if (st === 'pass') return 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
  if (st === 'warn') return 'bg-amber-500/15 text-amber-300 border-amber-500/30';
  return 'bg-rose-500/15 text-rose-300 border-rose-500/30';
}

function factorBadgeStyle(sev: 'good' | 'info' | 'warn' | 'bad') {
  if (sev === 'good') return 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
  if (sev === 'info') return 'bg-sky-500/15 text-sky-300 border-sky-500/30';
  if (sev === 'warn') return 'bg-amber-500/15 text-amber-300 border-amber-500/30';
  return 'bg-rose-500/15 text-rose-300 border-rose-500/30';
}

const locationDisplay = [report.geo.city, report.geo.region, report.geo.countryName]
  .filter(Boolean)
  .filter((v, idx, arr) => arr.indexOf(v) === idx)
  .join(', ');
---

<!-- Top Navigation -->
<header class="sticky top-0 z-30 border-b border-slate-800/80 bg-[#060911]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
    <a href={basePrefix || '/'} class="flex items-center gap-3 group">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-500/35 bg-emerald-500/10 text-emerald-400 transition group-hover:border-emerald-400">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.5 4.5l5 5-3 3-5-5 3-3zM12 7l5 5-9.5 9.5-5-5L12 7zM4 21h10" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-white">Judge<span class="text-emerald-400">IP</span></span>
        </div>
        <p class="hidden text-[11px] text-slate-400 sm:block">{t.brandSubtitle}</p>
      </div>
    </a>

    <nav class="flex items-center gap-2 sm:gap-5 text-sm">
      <a href={`${basePrefix || '/'}#verdict`} class="hidden text-slate-300 hover:text-emerald-400 transition md:inline">{t.navCheck}</a>
      <a href="#browser-probe" class="hidden text-slate-300 hover:text-emerald-400 transition md:inline">{t.navLeak}</a>
      <a href="#cli-api" class="hidden text-slate-300 hover:text-emerald-400 transition md:inline">{t.navApi}</a>
      <div class="flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-900/90 p-1 text-xs">
        <a
          href={isVisitor ? '/' : `/ip/${report.ip}`}
          class={`rounded px-2 py-1 font-medium transition ${locale === 'en' ? 'bg-emerald-500/20 text-emerald-300' : 'text-slate-400 hover:text-white'}`}
        >
          EN
        </a>
        <a
          href={isVisitor ? '/zh' : `/ip/${report.ip}?lang=zh`}
          class={`rounded px-2 py-1 font-medium transition ${locale === 'zh' ? 'bg-emerald-500/20 text-emerald-300' : 'text-slate-400 hover:text-white'}`}
        >
          中文
        </a>
      </div>
    </nav>
  </div>
</header>

<main
  id="judgeip-root"
  data-locale={locale}
  data-is-visitor={isVisitor ? '1' : '0'}
  data-initial-ip={report.ip}
  data-initial-version={String(report.version)}
  class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 space-y-7"
>
  <!-- Compact Hero & Search Bar -->
  <section class="text-center max-w-3xl mx-auto space-y-3.5">
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white">
      {scenarioSubtitle || t.heroTitle}
    </h1>
    <p class="text-sm text-slate-400 leading-relaxed max-w-2xl mx-auto">
      {t.heroDesc}
    </p>

    <form id="ip-lookup-form" action="/ip-lookup" method="get" class="mt-5 flex flex-col sm:flex-row gap-2.5 max-w-2xl mx-auto">
      <input type="hidden" name="lang" value={locale} />
      <div class="relative flex-1">
        <input
          id="ip-search-input"
          name="ip"
          type="text"
          defaultValue={isVisitor ? '' : report.ip}
          placeholder={t.inputPlaceholder}
          autocomplete="off"
          spellcheck="false"
          class="w-full rounded-xl border border-slate-700/80 bg-slate-900/90 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 font-mono-num"
        />
      </div>
      <div class="flex gap-2">
        <button
          type="submit"
          class="flex-1 sm:flex-none rounded-xl bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-slate-950 hover:bg-emerald-400 transition cursor-pointer"
        >
          {t.inspectBtn}
        </button>
        <a
          href={locale === 'zh' ? '/zh' : '/'}
          class="rounded-xl border border-slate-700 bg-slate-900/80 px-4 py-2.5 text-sm font-medium text-slate-200 hover:border-slate-500 hover:text-white transition"
        >
          {t.myIpBtn}
        </a>
      </div>
    </form>

    <!-- Preset Instant Examples -->
    <div class="flex flex-wrap items-center justify-center gap-2 pt-0.5 text-xs text-slate-400">
      <a
        href={`/ip/73.162.88.1${locale === 'zh' ? '?lang=zh' : ''}`}
        class="rounded-lg border border-slate-800 bg-slate-900/70 px-2.5 py-1 hover:border-emerald-500/40 hover:text-emerald-300 transition"
      >
        {t.sampleResidential} (73.162.88.1)
      </a>
      <a
        href={`/ip/45.76.12.8${locale === 'zh' ? '?lang=zh' : ''}`}
        class="rounded-lg border border-slate-800 bg-slate-900/70 px-2.5 py-1 hover:border-orange-500/40 hover:text-orange-300 transition"
      >
        {t.sampleVps} (45.76.12.8)
      </a>
      <a
        href={`/ip/185.156.46.12${locale === 'zh' ? '?lang=zh' : ''}`}
        class="rounded-lg border border-slate-800 bg-slate-900/70 px-2.5 py-1 hover:border-rose-500/40 hover:text-rose-300 transition"
      >
        {t.sampleVpn} (185.156.46.12)
      </a>
      <a
        href={`/ip/8.8.8.8${locale === 'zh' ? '?lang=zh' : ''}`}
        class="rounded-lg border border-slate-800 bg-slate-900/70 px-2.5 py-1 hover:border-sky-500/40 hover:text-sky-300 transition"
      >
        {t.sampleGoogle} (8.8.8.8)
      </a>
    </div>
  </section>

  <!-- Primary Verdict Card -->
  <section
    id="verdict"
    class={`rounded-2xl border ${theme.ring} bg-slate-900/75 p-6 sm:p-8 backdrop-blur-sm ${theme.glow}`}
  >
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <!-- Left: IP + Dual-Stack Switcher + Verdict Copy -->
      <div class="space-y-4 flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
            {t.yourCurrentIp}
          </span>
          <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium border ${isVisitor ? 'border-emerald-500/35 bg-emerald-500/15 text-emerald-300' : 'border-sky-500/35 bg-sky-500/15 text-sky-300'}`}>
            {isVisitor ? t.visitorTag : t.lookupTag}
          </span>
          <span id="active-ip-version-pill" class="rounded-full border border-slate-700 bg-slate-800/80 px-2.5 py-0.5 text-xs font-mono-num text-slate-300">
            IPv{report.version} · {report.latencyMs}ms
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <h2
            id="primary-ip-heading"
            class={`font-extrabold font-mono-num tracking-tight text-white break-all ${report.version === 6 ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-4xl'}`}
          >
            {report.ip}
          </h2>
          <span
            id="primary-grade-badge"
            class={`inline-flex items-center gap-1 rounded-lg border px-2.5 py-1 text-xs font-bold ${theme.ring} ${theme.bg} ${theme.text}`}
          >
            {t.gradePrefix} {report.grade}
          </span>
        </div>

        <!-- Dual-Stack IPv4 / IPv6 Bar (Automatically shows both IPv4 & IPv6 when visitor connects over Dual-Stack!) -->
        {isVisitor && (
          <div
            id="dual-stack-bar"
            class={`${report.version === 6 ? 'flex' : 'hidden'} flex-wrap items-center gap-2 rounded-xl border border-slate-800 bg-slate-950/65 px-3.5 py-2 text-xs`}
          >
            <span class="font-semibold text-emerald-400">IPv4:</span>
            <span id="detected-v4-text" class="font-mono-num font-semibold text-slate-200">
              {report.version === 4 ? report.ip : t.detectingIpv4}
            </span>
            <span id="dual-stack-divider" class="hidden text-slate-700">|</span>
            <span id="detected-v6-wrap" class={`${report.version === 6 ? 'inline-flex' : 'hidden'} items-center gap-1.5 text-slate-400`}>
              <span class="font-semibold text-sky-400">IPv6:</span>
              <span id="detected-v6-text" class="font-mono-num truncate max-w-[220px] sm:max-w-xs">{report.version === 6 ? report.ip : ''}</span>
            </span>
            <button
              id="switch-stack-btn"
              type="button"
              class="hidden ml-auto rounded-md border border-slate-700 bg-slate-800/90 px-2.5 py-1 text-[11px] font-medium text-slate-200 hover:border-emerald-400/60 hover:text-white transition cursor-pointer"
            >
              Switch
            </button>
          </div>
        )}

        <div class="space-y-1.5">
          <p id="verdict-headline" class={`text-lg sm:text-xl font-bold ${theme.text}`}>
            {locale === 'zh' ? report.verdictTitleZh : report.verdictTitleEn}
          </p>
          <p id="verdict-summary" class="text-sm text-slate-300 leading-relaxed max-w-2xl">
            {locale === 'zh' ? report.verdictSummaryZh : report.verdictSummaryEn}
          </p>
        </div>

        <!-- Quick Signal Tags -->
        <div class="flex flex-wrap gap-2 pt-1">
          <span
            id="tag-usage-type"
            class={`rounded-lg border px-3 py-1 text-xs font-medium ${
              report.network.usageType === 'residential' || report.network.usageType === 'mobile'
                ? 'border-emerald-500/35 bg-emerald-500/12 text-emerald-300'
                : 'border-rose-500/35 bg-rose-500/12 text-rose-300'
            }`}
          >
            {t.usageTypeLabels[report.network.usageType]}
          </span>

          <span
            id="tag-native-status"
            class={`rounded-lg border px-3 py-1 text-xs font-medium ${
              report.network.nativeStatus === 'native'
                ? 'border-emerald-500/35 bg-emerald-500/12 text-emerald-300'
                : report.network.nativeStatus === 'broadcast'
                  ? 'border-amber-500/35 bg-amber-500/12 text-amber-300'
                  : 'border-slate-700 bg-slate-800 text-slate-300'
            }`}
          >
            {t.nativeLabels[report.network.nativeStatus]} (RIR: {report.network.rirCountryCode})
          </span>

          <span id="tag-asn-cc" class="rounded-lg border border-slate-700/80 bg-slate-800/70 px-3 py-1 text-xs font-mono-num text-slate-300">
            {report.network.asnCode} · {report.geo.countryCode}
          </span>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-2.5 pt-2">
          <button
            id="copy-ip-btn"
            data-ip={report.ip}
            data-copied-label={t.ipCopiedBtn}
            data-default-label={t.copyIpBtn}
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800/90 px-3 py-1.5 text-xs font-medium text-slate-200 hover:border-emerald-400/60 hover:text-white transition cursor-pointer"
          >
            <span>{t.copyIpBtn}</span>
          </button>

          <button
            id="copy-report-btn"
            data-share-url={`https://judgeip.com/ip/${report.ip}${locale === 'zh' ? '?lang=zh' : ''}`}
            data-copied-label={t.copiedBtn}
            data-default-label={t.copyReportBtn}
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-900/90 px-3 py-1.5 text-xs font-medium text-slate-300 hover:border-slate-600 hover:text-white transition cursor-pointer"
          >
            <span>{t.copyReportBtn}</span>
          </button>

          <a
            id="json-api-link"
            href={`/api/v1/verdict?ip=${encodeURIComponent(report.ip)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-950/70 px-3 py-1.5 text-xs font-mono-num text-slate-400 hover:border-slate-600 hover:text-slate-200 transition"
          >
            <span>{`{ }`}</span>
            <span>{t.jsonApiBtn}</span>
          </a>
        </div>
      </div>

      <!-- Right: Circular Purity Score Gauge -->
      <div class="flex items-center justify-center lg:pl-6 lg:border-l lg:border-slate-800/90">
        <div class="flex flex-col items-center">
          <div class="relative h-36 w-36 flex items-center justify-center">
            <svg class="h-36 w-36 -rotate-90 transform" viewBox="0 0 136 136">
              <circle cx="68" cy="68" r={radius} stroke="#1e293b" stroke-width="10" fill="transparent" />
              <circle
                id="score-gauge-circle"
                cx="68"
                cy="68"
                r={radius}
                stroke={theme.stroke}
                stroke-width="10"
                stroke-dasharray={circumference}
                stroke-dashoffset={dashOffset}
                stroke-linecap="round"
                fill="transparent"
              />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="score-gauge-number" class={`text-4xl font-extrabold font-mono-num ${theme.text}`}>{report.score}</span>
              <span class="text-[10px] font-bold tracking-widest text-slate-400">/ 100</span>
            </div>
          </div>
          <span class="mt-2 text-[11px] font-semibold tracking-wider text-slate-300">{t.purityScoreLabel}</span>
          <span class="mt-0.5 text-xs text-slate-400 font-mono-num">
            {t.fraudRiskLabel}: <strong id="fraud-risk-val" class="text-slate-200">{report.fraudRisk}%</strong>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Network Details & Browser Leak Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Network & RIR Details (7 cols) -->
    <section class="lg:col-span-7 rounded-2xl border border-slate-800/90 bg-slate-900/60 p-6 space-y-5">
      <div class="flex items-center justify-between border-b border-slate-800/80 pb-3.5">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          {t.sectionIdentity}
        </h3>
        <span id="detail-asn-code" class="text-xs font-mono-num text-slate-400">{report.network.asnCode}</span>
      </div>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5">
          <dt class="text-xs text-slate-400">{t.fieldLocation}</dt>
          <dd id="detail-location" class="mt-1 font-semibold text-slate-100">{locationDisplay || report.geo.countryCode}</dd>
        </div>

        <div class="rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5">
          <dt class="text-xs text-slate-400">{t.fieldIsp}</dt>
          <dd id="detail-isp" class="mt-1 font-semibold text-slate-100 truncate" title={report.network.isp}>{report.network.isp}</dd>
        </div>

        <div class="rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5">
          <dt class="text-xs text-slate-400">{t.fieldNative}</dt>
          <dd class="mt-1 font-semibold flex items-center gap-2">
            <span id="detail-native-label" class={report.network.nativeStatus === 'native' ? 'text-emerald-400' : report.network.nativeStatus === 'broadcast' ? 'text-amber-300' : 'text-slate-200'}>
              {t.nativeLabels[report.network.nativeStatus]}
            </span>
            <span id="detail-native-pair" class="text-xs font-mono-num text-slate-400">
              ({report.network.rirCountryCode} → {report.geo.countryCode})
            </span>
          </dd>
        </div>

        <div class="rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5">
          <dt class="text-xs text-slate-400">{t.fieldTimezone}</dt>
          <dd id="detail-tz" class="mt-1 font-semibold font-mono-num text-slate-100">{report.geo.timezone}</dd>
        </div>

        <div class="rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5">
          <dt class="text-xs text-slate-400">{t.fieldPorts}</dt>
          <dd id="detail-ports" class="mt-1 font-mono-num text-xs font-semibold">
            {report.signals.openPorts.length > 0 ? (
              <span class="text-amber-300">{report.signals.openPorts.join(', ')}</span>
            ) : (
              <span class="text-emerald-400">{t.noOpenPorts}</span>
            )}
          </dd>
        </div>

        <div class="rounded-xl border border-slate-800/70 bg-slate-950/50 p-3.5">
          <dt class="text-xs text-slate-400">{t.fieldHostnames}</dt>
          <dd id="detail-ptr" class="mt-1 font-mono-num text-xs text-slate-300 truncate" title={report.signals.hostnames.join(', ')}>
            {report.signals.hostnames[0] || t.noPtr}
          </dd>
        </div>
      </dl>

      <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px] text-slate-500">
        <span>Data:</span>
        {report.sources.map((src) => (
          <span class="rounded bg-slate-800/70 px-2 py-0.5 text-slate-400">{src}</span>
        ))}
      </div>
    </section>

    <!-- Live Browser WebRTC & Environment Check (5 cols) -->
    <section
      id="browser-probe"
      data-is-visitor={isVisitor ? '1' : '0'}
      data-expected-ip={report.ip}
      data-expected-tz={report.geo.timezone}
      data-expected-cc={report.geo.countryCode}
      data-label-clean={t.probeClean}
      data-label-mismatch={t.probeMismatch}
      class="lg:col-span-5 rounded-2xl border border-slate-800/90 bg-slate-900/60 p-6 space-y-4"
    >
      <div class="border-b border-slate-800/80 pb-3.5">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-sky-400"></span>
            {t.sectionClientProbe}
          </h3>
          <span id="probe-overall-badge" class="rounded-full border border-slate-700 bg-slate-800 px-2.5 py-0.5 text-[11px] font-semibold text-slate-300">
            {isVisitor ? '...' : 'N/A'}
          </span>
        </div>
        <p class="mt-1 text-xs text-slate-400">{t.sectionClientProbeDesc}</p>
      </div>

      {!isVisitor ? (
        <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4 text-xs text-slate-400 leading-relaxed">
          {t.probeSkippedLookup}
        </div>
      ) : (
        <div class="space-y-2.5 text-xs">
          <div class="flex items-center justify-between rounded-xl border border-slate-800/80 bg-slate-950/55 px-3.5 py-2.5">
            <span class="text-slate-400">{t.probeWebrtc}</span>
            <span id="probe-webrtc-val" class="font-mono-num font-semibold text-slate-200">{t.probeRunning}</span>
          </div>
          <div class="flex items-center justify-between rounded-xl border border-slate-800/80 bg-slate-950/55 px-3.5 py-2.5">
            <span class="text-slate-400">{t.probeTz}</span>
            <span id="probe-tz-val" class="font-mono-num font-semibold text-slate-200">...</span>
          </div>
          <div class="flex items-center justify-between rounded-xl border border-slate-800/80 bg-slate-950/55 px-3.5 py-2.5">
            <span class="text-slate-400">{t.probeLang}</span>
            <span id="probe-lang-val" class="font-mono-num font-semibold text-slate-200">...</span>
          </div>
          <div class="flex items-center justify-between rounded-xl border border-slate-800/80 bg-slate-950/55 px-3.5 py-2.5">
            <span class="text-slate-400">{t.probeWebdriver}</span>
            <span id="probe-webdriver-val" class="font-mono-num font-semibold text-slate-200">...</span>
          </div>
          <div class="flex items-center justify-between rounded-xl border border-slate-800/80 bg-slate-950/55 px-3.5 py-2.5">
            <span class="text-slate-400">{t.probeRtt}</span>
            <span id="probe-rtt-val" class="font-mono-num font-semibold text-slate-200">...</span>
          </div>
        </div>
      )}
    </section>
  </div>

  <!-- Platform Compatibility Matrix -->
  {report.platforms.length > 0 && (
    <section class="rounded-2xl border border-slate-800/90 bg-slate-900/60 p-6 sm:p-7 space-y-5">
      <div>
        <h3 class="text-lg font-bold text-white">{t.sectionPlatforms}</h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-0.5">{t.sectionPlatformsDesc}</p>
      </div>

      <div id="platforms-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {report.platforms.map((p) => (
          <div class="rounded-xl border border-slate-800/90 bg-slate-950/60 p-4 flex flex-col justify-between gap-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold text-sm text-white">
                  {locale === 'zh' ? p.nameZh : p.nameEn}
                </span>
                <span class={`rounded-md border px-2 py-0.5 text-[11px] font-semibold ${platformBadgeStyle(p.status)}`}>
                  {locale === 'zh' ? p.badgeZh : p.badgeEn}
                </span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {locale === 'zh' ? p.reasonZh : p.reasonEn}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Score Breakdown -->
  <section class="rounded-2xl border border-slate-800/90 bg-slate-900/60 p-6 sm:p-7 space-y-5">
    <div>
      <h3 class="text-lg font-bold text-white">{t.sectionFactors}</h3>
      <p class="text-xs sm:text-sm text-slate-400 mt-0.5">{t.sectionFactorsDesc}</p>
    </div>

    <div id="factors-list" class="space-y-3">
      {report.factors.map((f) => (
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl border border-slate-800/80 bg-slate-950/55 p-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2.5">
              <span class={`rounded border px-2 py-0.5 text-xs font-mono-num font-bold ${factorBadgeStyle(f.severity)}`}>
                {f.delta > 0 ? `+${f.delta}` : f.delta === 0 ? 'OK' : `${f.delta}`}
              </span>
              <h4 class="font-semibold text-sm text-slate-100">
                {locale === 'zh' ? f.titleZh : f.titleEn}
              </h4>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              {locale === 'zh' ? f.detailZh : f.detailEn}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CLI & Developer Edge API Section -->
  <section id="cli-api" class="rounded-2xl border border-slate-800/90 bg-slate-900/60 p-6 sm:p-7 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h3 class="text-lg font-bold text-white">{t.cliSectionTitle}</h3>
        <p class="text-xs sm:text-sm text-slate-400">{t.cliSectionDesc}</p>
      </div>
      <span class="text-xs font-mono-num text-emerald-400">judgeip.com · ipnano.io</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono-num text-xs">
      <div class="rounded-xl border border-slate-800 bg-[#05070d] p-4 space-y-2 overflow-x-auto">
        <div class="text-slate-500"># Plain-text IP / Edge JSON</div>
        <div class="text-emerald-300">$ curl -sL ipnano.io</div>
        <div id="cli-ip-example" class="text-slate-400">{report.ip}</div>
        <div class="text-emerald-300 pt-1">$ curl -sL ipnano.io/json</div>
      </div>
      <div class="rounded-xl border border-slate-800 bg-[#05070d] p-4 space-y-2 overflow-x-auto">
        <div class="text-slate-500"># Full Purity Score & RIR JSON</div>
        <div id="cli-api-cmd" class="text-sky-300">$ curl -s "https://judgeip.com/api/v1/verdict?ip={report.ip}"</div>
        <div class="text-slate-400">{`{ "score": ${report.score}, "grade": "${report.grade}", "nativeStatus": "${report.network.nativeStatus}" }`}</div>
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-slate-800/80 bg-[#050810] py-8 mt-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
    <div>
      <strong class="text-slate-300">JudgeIP.com</strong> — {t.footerTagline}
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <a href="/tiktok-ip-check" class="hover:text-slate-300 transition">TikTok IP Check</a>
      <a href="/claude-ip-check" class="hover:text-slate-300 transition">Claude / AI Check</a>
      <a href="/native-ip-check" class="hover:text-slate-300 transition">Native IP Check</a>
      <a href="/api/v1/verdict" class="hover:text-slate-300 transition">API</a>
    </div>
  </div>
</footer>

<script>
  // Copy IP & Copy Report Link buttons
  function bindCopyButton(id: string, attrName: string) {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const val = btn.getAttribute(attrName) || '';
      const copiedText = btn.getAttribute('data-copied-label') || 'Copied';
      const defaultText = btn.getAttribute('data-default-label') || 'Copy';
      const span = btn.querySelector('span');
      try {
        await navigator.clipboard.writeText(val);
        if (span) span.textContent = copiedText;
        setTimeout(() => {
          if (span) span.textContent = defaultText;
        }, 1800);
      } catch {
        window.prompt('Copy:', val);
      }
    });
  }
  bindCopyButton('copy-ip-btn', 'data-ip');
  bindCopyButton('copy-report-btn', 'data-share-url');

  // Dual-Stack IPv4 Priority Auto-Detection:
  // Modern browsers connect to Cloudflare over IPv6 first (Happy Eyeballs), which hides the user's familiar IPv4.
  // When a visitor arrives over IPv6, we automatically detect their public IPv4 in the background, promote IPv4
  // to the main display (with full IPv4 purity verdict & port scan!), and keep IPv6 one click away in the dual-stack bar.
  const rootEl = document.getElementById('judgeip-root');
  if (rootEl && rootEl.getAttribute('data-is-visitor') === '1') {
    const locale = rootEl.getAttribute('data-locale') === 'zh' ? 'zh' : 'en';
    const initialIp = rootEl.getAttribute('data-initial-ip') || '';
    const initialVer = rootEl.getAttribute('data-initial-version') || '4';

    const usageLabels: Record<string, Record<string, string>> = {
      en: { residential: 'Residential ISP', mobile: 'Mobile Network', hosting: 'Hosting / IDC', business: 'Business', education: 'Education', cdn: 'CDN / Anycast', reserved: 'Private / Local' },
      zh: { residential: '家庭宽带', mobile: '移动网络', hosting: '机房 / 云主机', business: '企业专线', education: '教育网', cdn: 'CDN / 边缘节点', reserved: '内网地址' },
    };
    const nativeLabels: Record<string, Record<string, string>> = {
      en: { native: 'Native IP', broadcast: 'Broadcast IP', anycast: 'Anycast', unknown: 'Unverified' },
      zh: { native: '原生 IP', broadcast: '广播 IP', anycast: '任播节点', unknown: '未核验' },
    };
    const gradeStrokes: Record<string, { text: string; stroke: string }> = {
      S: { text: 'text-emerald-400', stroke: '#10b981' },
      A: { text: 'text-teal-300', stroke: '#2dd4bf' },
      B: { text: 'text-amber-300', stroke: '#fbbf24' },
      C: { text: 'text-orange-400', stroke: '#f97316' },
      D: { text: 'text-rose-400', stroke: '#f43f5e' },
    };

    async function detectPublicIpv4(): Promise<string | null> {
      const endpoints = ['https://ipv4.icanhazip.com', 'https://v4.ident.me', 'https://checkip.amazonaws.com'];
      for (const ep of endpoints) {
        try {
          const ctrl = new AbortController();
          const t = setTimeout(() => ctrl.abort(), 2500);
          const r = await fetch(ep, { signal: ctrl.signal, cache: 'no-store' });
          clearTimeout(t);
          if (r.ok) {
            const txt = (await r.text()).trim();
            if (/^(?:\d{1,3}\.){3}\d{1,3}$/.test(txt)) return txt;
          }
        } catch {
          // try next
        }
      }
      return null;
    }

    // Store reports keyed by IP so user can toggle between their IPv4 and IPv6 seamlessly
    const cachedReports: Record<string, any> = {};

    function applyReportToDom(rep: any) {
      const heading = document.getElementById('primary-ip-heading');
      if (heading) {
        heading.textContent = rep.ip;
        heading.className = `font-extrabold font-mono-num tracking-tight text-white break-all ${rep.version === 6 ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-4xl'}`;
      }
      const verPill = document.getElementById('active-ip-version-pill');
      if (verPill) verPill.textContent = `IPv${rep.version} · ${rep.latencyMs}ms`;

      const gTheme = gradeStrokes[rep.grade] || gradeStrokes.A;
      const gradeBadge = document.getElementById('primary-grade-badge');
      if (gradeBadge) gradeBadge.textContent = `${locale === 'zh' ? '等级' : 'Grade'} ${rep.grade}`;

      const headline = document.getElementById('verdict-headline');
      if (headline) {
        headline.textContent = locale === 'zh' ? rep.verdictTitleZh : rep.verdictTitleEn;
        headline.className = `text-lg sm:text-xl font-bold ${gTheme.text}`;
      }
      const summary = document.getElementById('verdict-summary');
      if (summary) summary.textContent = locale === 'zh' ? rep.verdictSummaryZh : rep.verdictSummaryEn;

      const scoreNum = document.getElementById('score-gauge-number');
      if (scoreNum) {
        scoreNum.textContent = String(rep.score);
        scoreNum.className = `text-4xl font-extrabold font-mono-num ${gTheme.text}`;
      }
      const circle = document.getElementById('score-gauge-circle');
      if (circle) {
        const circ = 2 * Math.PI * 56;
        circle.setAttribute('stroke', gTheme.stroke);
        circle.setAttribute('stroke-dashoffset', String(circ - (rep.score / 100) * circ));
      }
      const riskVal = document.getElementById('fraud-risk-val');
      if (riskVal) riskVal.textContent = `${rep.fraudRisk}%`;

      const tagUsage = document.getElementById('tag-usage-type');
      if (tagUsage) tagUsage.textContent = usageLabels[locale][rep.network.usageType] || rep.network.usageType;

      const tagNative = document.getElementById('tag-native-status');
      if (tagNative) tagNative.textContent = `${nativeLabels[locale][rep.network.nativeStatus]} (RIR: ${rep.network.rirCountryCode})`;

      const tagAsn = document.getElementById('tag-asn-cc');
      if (tagAsn) tagAsn.textContent = `${rep.network.asnCode} · ${rep.geo.countryCode}`;

      const copyIpBtn = document.getElementById('copy-ip-btn');
      if (copyIpBtn) copyIpBtn.setAttribute('data-ip', rep.ip);
      const copyRepBtn = document.getElementById('copy-report-btn');
      if (copyRepBtn) copyRepBtn.setAttribute('data-share-url', `https://judgeip.com/ip/${rep.ip}${locale === 'zh' ? '?lang=zh' : ''}`);
      const jsonLink = document.getElementById('json-api-link');
      if (jsonLink) jsonLink.setAttribute('href', `/api/v1/verdict?ip=${encodeURIComponent(rep.ip)}`);

      const locParts = [rep.geo.city, rep.geo.region, rep.geo.countryName].filter(Boolean).filter((v: string, i: number, a: string[]) => a.indexOf(v) === i);
      const detLoc = document.getElementById('detail-location');
      if (detLoc) detLoc.textContent = locParts.join(', ') || rep.geo.countryCode;
      const detIsp = document.getElementById('detail-isp');
      if (detIsp) detIsp.textContent = rep.network.isp;
      const detAsn = document.getElementById('detail-asn-code');
      if (detAsn) detAsn.textContent = rep.network.asnCode;
      const detNativeLbl = document.getElementById('detail-native-label');
      if (detNativeLbl) detNativeLbl.textContent = nativeLabels[locale][rep.network.nativeStatus];
      const detNativePair = document.getElementById('detail-native-pair');
      if (detNativePair) detNativePair.textContent = `(${rep.network.rirCountryCode} → ${rep.geo.countryCode})`;
      const detTz = document.getElementById('detail-tz');
      if (detTz) detTz.textContent = rep.geo.timezone;
      const detPorts = document.getElementById('detail-ports');
      if (detPorts) {
        detPorts.innerHTML =
          rep.signals.openPorts && rep.signals.openPorts.length > 0
            ? `<span class="text-amber-300">${rep.signals.openPorts.join(', ')}</span>`
            : `<span class="text-emerald-400">${locale === 'zh' ? '未发现开放端口' : 'None detected'}</span>`;
      }
      const detPtr = document.getElementById('detail-ptr');
      if (detPtr) detPtr.textContent = (rep.signals.hostnames && rep.signals.hostnames[0]) || (locale === 'zh' ? '无记录' : 'None');

      const cliIp = document.getElementById('cli-ip-example');
      if (cliIp) cliIp.textContent = rep.ip;
      const cliCmd = document.getElementById('cli-api-cmd');
      if (cliCmd) cliCmd.textContent = `$ curl -s "https://judgeip.com/api/v1/verdict?ip=${rep.ip}"`;
    }

    if (initialVer === '6') {
      (async () => {
        const v4 = await detectPublicIpv4();
        const v4Text = document.getElementById('detected-v4-text');
        const divider = document.getElementById('dual-stack-divider');
        const switchBtn = document.getElementById('switch-stack-btn');

        if (!v4) {
          if (v4Text) v4Text.textContent = locale === 'zh' ? '纯 IPv6 网络' : 'IPv6 Only';
          return;
        }
        if (v4Text) v4Text.textContent = v4;
        if (divider) divider.classList.remove('hidden');

        // Fetch full verdict for the visitor's IPv4 and make IPv4 the primary display!
        try {
          const [v4Res, v6Res] = await Promise.all([
            fetch(`/api/v1/verdict?ip=${encodeURIComponent(v4)}`).then((r) => r.json()),
            fetch(`/api/v1/verdict?ip=${encodeURIComponent(initialIp)}`).then((r) => r.json()),
          ]);
          if (v4Res?.ok && v4Res.report) {
            cachedReports[v4] = v4Res.report;
            if (v6Res?.ok && v6Res.report) cachedReports[initialIp] = v6Res.report;

            let showingV4 = true;
            applyReportToDom(v4Res.report);

            if (switchBtn && cachedReports[initialIp]) {
              switchBtn.classList.remove('hidden');
              switchBtn.textContent = locale === 'zh' ? '切换查看 IPv6' : 'View IPv6';
              switchBtn.addEventListener('click', () => {
                showingV4 = !showingV4;
                applyReportToDom(showingV4 ? cachedReports[v4] : cachedReports[initialIp]);
                switchBtn.textContent = showingV4
                  ? locale === 'zh' ? '切换查看 IPv6' : 'View IPv6'
                  : locale === 'zh' ? '切换查看 IPv4' : 'View IPv4';
              });
            }
          }
        } catch {
          // Keep IPv6 display if API call fails
        }
      })();
    }
  }

  // Client-side WebRTC + Timezone + WebDriver + Edge RTT probe
  const probeEl = document.getElementById('browser-probe');
  if (probeEl && probeEl.getAttribute('data-is-visitor') === '1') {
    const expectedIp = probeEl.getAttribute('data-expected-ip') || '';
    const expectedTz = probeEl.getAttribute('data-expected-tz') || '';
    const expectedCc = (probeEl.getAttribute('data-expected-cc') || '').toUpperCase();
    const labelClean = probeEl.getAttribute('data-label-clean') || 'No Leaks';
    const labelMismatch = probeEl.getAttribute('data-label-mismatch') || 'Mismatch';

    const badgeEl = document.getElementById('probe-overall-badge');
    const webrtcEl = document.getElementById('probe-webrtc-val');
    const tzEl = document.getElementById('probe-tz-val');
    const langEl = document.getElementById('probe-lang-val');
    const wdEl = document.getElementById('probe-webdriver-val');
    const rttEl = document.getElementById('probe-rtt-val');

    let warnings = 0;

    // 1. Timezone alignment check
    const sysTz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Unknown';
    if (tzEl) {
      const tzAligned = !expectedTz || expectedTz === 'UTC' || sysTz === expectedTz || sysTz.split('/')[0] === expectedTz.split('/')[0];
      tzEl.textContent = tzAligned ? `${sysTz}` : `${sysTz} ≠ ${expectedTz}`;
      tzEl.className = `font-mono-num font-semibold ${tzAligned ? 'text-emerald-400' : 'text-amber-300'}`;
      if (!tzAligned) warnings++;
    }

    // 2. Navigator language check
    const navLangs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]).slice(0, 2).join(', ');
    if (langEl) {
      const hasZhLocaleOnForeignIp = expectedCc && !['CN', 'HK', 'TW', 'SG', 'MO', 'LO'].includes(expectedCc) && /zh/i.test(navLangs);
      langEl.textContent = navLangs;
      langEl.className = `font-mono-num font-semibold ${hasZhLocaleOnForeignIp ? 'text-amber-300' : 'text-emerald-400'}`;
      if (hasZhLocaleOnForeignIp) warnings++;
    }

    // 3. Automation / WebDriver check
    const isAutomated = Boolean(navigator.webdriver);
    if (wdEl) {
      wdEl.textContent = isAutomated ? 'Detected' : 'Normal';
      wdEl.className = `font-mono-num font-semibold ${isAutomated ? 'text-rose-400' : 'text-emerald-400'}`;
      if (isAutomated) warnings++;
    }

    // 4. Edge HTTP RTT measurement
    (async () => {
      try {
        const t0 = performance.now();
        const resp = await fetch('/api/v1/ping', { cache: 'no-store' });
        const httpRtt = Math.round(performance.now() - t0);
        const data = await resp.json();
        if (rttEl) {
          const colo = data.colo || 'EDGE';
          rttEl.textContent = `${httpRtt}ms (${colo})`;
          rttEl.className = `font-mono-num font-semibold ${httpRtt > 450 ? 'text-amber-300' : 'text-emerald-400'}`;
        }
      } catch {
        if (rttEl) rttEl.textContent = '—';
      }
    })();

    // 5. WebRTC STUN ICE Candidate Leak Probe
    (async () => {
      if (typeof RTCPeerConnection === 'undefined') {
        if (webrtcEl) {
          webrtcEl.textContent = 'Disabled';
          webrtcEl.className = 'font-mono-num font-semibold text-emerald-400';
        }
        finalizeBadge();
        return;
      }

      const discoveredIps = new Set<string>();
      try {
        const pc = new RTCPeerConnection({
          iceServers: [{ urls: 'stun:stun.cloudflare.com:3478' }, { urls: 'stun:stun.l.google.com:19302' }],
        });
        pc.createDataChannel('judgeip');
        pc.onicecandidate = (event) => {
          const cand = event.candidate?.candidate || '';
          const ipMatch = cand.match(/(?:\b(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(?:\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}\b)|(?:\b(?:[0-9a-fA-F]{1,4}:){2,7}[0-9a-fA-F]{1,4}\b)/);
          if (ipMatch && !ipMatch[0].startsWith('192.168.') && !ipMatch[0].startsWith('10.') && !ipMatch[0].endsWith('.local')) {
            discoveredIps.add(ipMatch[0]);
          }
        };
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        await new Promise((r) => setTimeout(r, 1400));
        pc.close();
      } catch {
        // Ignore RTCPeerConnection restrictions
      }

      if (webrtcEl) {
        if (discoveredIps.size === 0) {
          webrtcEl.textContent = 'Protected (mDNS)';
          webrtcEl.className = 'font-mono-num font-semibold text-emerald-400';
        } else {
          const list = Array.from(discoveredIps);
          const v4Displayed = document.getElementById('detected-v4-text')?.textContent?.trim() || '';
          const knownSelfIps = new Set([expectedIp, v4Displayed].filter(Boolean));
          const leakedIp = list.find((ip) => !knownSelfIps.has(ip));
          webrtcEl.textContent = leakedIp ? `${leakedIp} (Mismatch)` : `${list[0]}`;
          webrtcEl.className = `font-mono-num font-semibold ${leakedIp ? 'text-rose-400' : 'text-emerald-400'}`;
          if (leakedIp) warnings++;
        }
      }
      finalizeBadge();
    })();

    function finalizeBadge() {
      if (!badgeEl) return;
      if (warnings === 0) {
        badgeEl.textContent = labelClean;
        badgeEl.className = 'rounded-full border border-emerald-500/35 bg-emerald-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-300';
      } else {
        badgeEl.textContent = `${warnings} ${labelMismatch}`;
        badgeEl.className = 'rounded-full border border-amber-500/35 bg-amber-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-amber-300';
      }
    }
  }
</script>
