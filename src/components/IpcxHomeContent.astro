---
import { STREAM_SOURCES, type HomeIpLookupResult } from '../lib/ipcx-lookup';
import { getLang, localePath } from '../lib/i18n';
import { formatDelta } from '../lib/score-rules';
import { limitedNotice } from '../lib/lookup-en';

const lang = getLang(Astro.locals);
const t = (zh: string, en: string) => (lang === 'en' ? en : zh);
const lp = (path: string) => localePath(path, lang);

interface Props {
  info: HomeIpLookupResult;
  isSelf: boolean;
  queryValue?: string;
  errorMsg?: string;
}

const { info, isSelf, queryValue = '', errorMsg: queryError = '' } = Astro.props;
const errorMsg = queryError || limitedNotice(info, lang);
const encodedIp = encodeURIComponent(info.ip);

function scoreRiskTier(score: number | null) {
  if (score === null) {
    return {
      cls: 'muted',
      badge: 'gray',
      label: t('暂未评分', 'No score'),
      desc: info.lookupStatus === 'limited'
        ? t('查询过于频繁，本次未请求数据源', 'Too many lookups; data sources were not queried')
        : info.version === 6
        ? t('端口与黑名单数据仅覆盖 IPv4，暂不出综合分', 'Port and blocklist feeds cover IPv4 only')
        : t('部分公开数据源未及时返回，暂不出分', 'Some upstream sources did not respond in time'),
    };
  }
  if (score >= 90) {
    return {
      cls: 'excellent',
      badge: 'green',
      label: t('已查风险较少', 'Few observed risks'),
      desc: t('仅反映已查来源，不能保证平台放行', 'Checked sources only; platform acceptance is not guaranteed'),
    };
  }
  if (score >= 80) {
    return {
      cls: 'good',
      badge: 'green',
      label: t('纯净', 'Clean'),
      desc: t('已查信号有限，不代表没有滥用记录', 'Limited observed signals do not rule out abuse'),
    };
  }
  if (score >= 68) {
    return {
      cls: 'ok',
      badge: 'green',
      label: t('正常', 'Normal'),
      desc: t('规则参考分，请结合信誉覆盖与原始证据', 'Rule-based estimate; review coverage and raw evidence'),
    };
  }
  if (score >= 50) {
    return {
      cls: 'warn',
      badge: 'amber',
      label: t('低风险', 'Low risk'),
      desc: t('信誉证据可能不足，或存在网络与风险标记', 'Reputation evidence may be limited, or risk flags were found'),
    };
  }
  if (score >= 30) {
    return {
      cls: 'bad',
      badge: 'danger',
      label: t('中风险', 'Medium risk'),
      desc: t('已查风险或证据缺口较大，使用前需核实', 'Risk flags or material evidence gaps; verify before use'),
    };
  }
  return {
    cls: 'danger',
    badge: 'danger',
    label: t('高风险', 'High risk'),
    desc: t('已查证据触发高风险规则，建议核对来源', 'Observed evidence triggered high-risk rules; review the sources'),
  };
}

const tier = info.score !== null && info.reputationCoverage !== 'complete' && info.hasThreat !== true
  ? { cls: 'muted', badge: 'gray', label: t('信誉证据不足', 'Limited reputation evidence'), desc: t('分数受证据上限限制；不代表已发现滥用，也不能判为纯净', 'Score capped for missing evidence; neither proof of abuse nor a clean verdict') }
  : scoreRiskTier(info.score);
const activeDeductions = info.factors.filter((f) => f.delta < 0 && f.key !== 'clamp');
---

<!-- Section Jump Bar + Compact Search (ipfinal style) -->
<div class="secnav">
  <div class="secnav__links" role="navigation" aria-label={t('本页模块导航', 'Section jump links')}>
    <a class="secnav__link is-active" href="#ip-hero">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.2"></circle><path d="M8 7.2v4M8 4.9v.2" stroke-linecap="round"></path></svg>
      <span>{t('IP 信息', 'IP Info')}</span>
    </a>
    <a class="secnav__link" href="#scene-fit" data-public-panel hidden={info.isBogon}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2l1.6 3.6L13.2 7 9.6 8.6 8 12.2 6.4 8.6 2.8 7l3.6-1.4L8 2z" stroke-linejoin="round"></path></svg>
      <span>{t('场景适配', 'Scene Fit')}</span>
    </a>
    <a class="secnav__link" href="#score-factors" data-public-panel hidden={info.isBogon}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4.5h10M3 8h10M3 11.5h6.5" stroke-linecap="round"></path></svg>
      <span>{t('评分证据', 'Evidence')}</span>
    </a>
    <a class="secnav__link" href="#risk-tech" data-public-panel hidden={info.isBogon}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 1.8l5.2 2.3v3.8c0 3.2-2.2 5.7-5.2 6.4-3-.7-5.2-3.2-5.2-6.4V4.1L8 1.8z" stroke-linejoin="round"></path></svg>
      <span>{t('风险检测', 'Risk & BGP')}</span>
    </a>
    <a class="secnav__link" href="#multi-geo" data-public-panel hidden={info.isBogon}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 14s4.5-4.1 4.5-7.5a4.5 4.5 0 1 0-9 0C3.5 9.9 8 14 8 14z"></path><circle cx="8" cy="6.5" r="1.5"></circle></svg>
      <span>{t('多库定位', 'Geo DBs')}</span>
    </a>
    {isSelf && (
      <a class="secnav__link" href="#net-conn" data-self-only>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.2 6.2a8.5 8.5 0 0 1 11.6 0M4.6 8.8a5 5 0 0 1 6.8 0M7.2 11.5a1.2 1.2 0 0 1 1.6 0" stroke-linecap="round"></path></svg>
        <span>{t('网络检测', 'Network')}</span>
      </a>
    )}
  </div>

  <form class="secnav__search" method="get" action={lp('/')} novalidate role="search" data-ip-search-form>
    <input
      class="secnav__input mono"
      type="text"
      name="ip"
      value={queryValue}
      data-mask-query
      data-ip-search-input
      placeholder={t('查任意 IPv4 / IPv6…', 'Check any IPv4 / IPv6…')}
      inputmode="text"
      enterkeyhint="search"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label={t('要查询的 IP 地址', 'IP address to look up')}
    />
    <button class="secnav__submit" type="submit" data-ip-search-btn aria-label={t('查询', 'Look up')} title={t('查询', 'Look up')}>
      <svg class="secnav__btn-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8.8" cy="8.8" r="5.4"></circle>
        <path d="m16.5 16.5-3.8-3.8"></path>
      </svg>
      <span class="secnav__btn-text">{t('查询中…', 'Querying…')}</span>
    </button>
  </form>
</div>

<p class="notice notice--top" role="alert" data-search-error hidden={!errorMsg}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 7.5v5.2M12 16.3v.2"></path>
  </svg>
  <span data-search-error-text>{errorMsg}</span>
</p>

<!-- Unified Hero Inspection Box (ipfinal style) -->
<section class="hero-box current" id="ip-hero" data-current-card data-is-self={isSelf ? '1' : '0'} data-initial-version={String(info.version)}>
  <!-- Top IP Strip -->
  <div class="hero-box__top">
    <div class="hero-box__identity">
      <span class="proto-pill mono" data-field="protoVersion">IPv{info.version}</span>

      <button class="mask" type="button" data-mask-toggle aria-pressed="false" aria-label={t('隐藏 IP 地址', 'Hide IP address')} title={t('隐藏 IP 地址', 'Hide IP address')}>
        <svg class="mask__icon mask__icon--show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.6 12S6.4 5.8 12 5.8 21.4 12 21.4 12 17.6 18.2 12 18.2 2.6 12 2.6 12z"></path>
          <circle cx="12" cy="12" r="2.9"></circle>
        </svg>
        <svg class="mask__icon mask__icon--hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9.9 5.9A9.6 9.6 0 0 1 12 5.8c5.6 0 9.4 6.2 9.4 6.2a17.7 17.7 0 0 1-2.7 3.4M6.2 7.4A17.4 17.4 0 0 0 2.6 12S6.4 18.2 12 18.2a9.4 9.4 0 0 0 3.9-.8"></path>
          <path d="M10 10a2.9 2.9 0 0 0 4 4"></path>
          <path d="M4 4l16 16"></path>
        </svg>
      </button>

      <span class="current__ip mono" id="current-ip">{info.ip}</span>

      <button class="hero-icon-copy copy" type="button" data-copy-target="current-ip" data-copy-done={t('已复制', 'Copied')} title={t('复制 IP 地址', 'Copy IP address')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2.5"></rect>
          <path d="M5.5 15A2.5 2.5 0 0 1 4 12.7V6.5A2.5 2.5 0 0 1 6.5 4h6.2A2.5 2.5 0 0 1 15 5.5"></path>
        </svg>
        <span class="copy__label sr-only">{t('复制', 'Copy')}</span>
      </button>

      <span class="hero-box__pills" data-field="ipType">
        <span class={`badge badge--solid badge--${info.ipTypeTone}`}>{info.ipTypeLabel}</span>
        {info.isDualIsp && (
          <span class="badge badge--solid badge--green" title={t('ASN 与地址段登记机构均为电信/宽带运营商', 'Both origin ASN and range registrant are consumer ISPs')}>
            {t('双 ISP', 'Dual ISP')}
          </span>
        )}
        {!info.isBogon && (
          <span class={`badge badge--solid badge--${info.isNative === null ? 'gray' : info.isNative ? 'green' : 'amber'}`}>
            {info.isNative === null ? t('原生未知', 'Origin unknown') : info.isNative ? t('原生 IP', 'Native IP') : t('广播 IP', 'Geo-announced')}
          </span>
        )}
        {info.isProxy && <span class="badge badge--solid badge--danger">{info.proxyLabel}</span>}
      </span>
    </div>

    <div class="hero-box__top-skel" aria-hidden="true"></div>

    <div class="hero-box__status" data-field="heroStatusWrap">
      <span class="eyebrow-tag" data-field="eyebrowTag">{isSelf ? t('当前出口', 'Your Egress') : t('指定查询', 'Queried IP')}</span>
      <a class="hero-back" href={lp('/')} data-field="backMyIp" hidden={isSelf}>{t('返回本机 ›', 'My IP ›')}</a>
    </div>
  </div>

  <!-- Split Dashboard Body -->
  <div class="hero-box__body">
    <!-- Left Column: Purity Score Gauge & Summary Reasons -->
    <div class="hero-score" data-field="heroScorePanel">
      <div class="hero-score__head">
        <span class="hero-score__title">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M3.2 12.5a6.5 6.5 0 1 1 11.6 0" stroke-linecap="round"></path>
            <path d="M9 9.5 12.2 6" stroke-linecap="round"></path>
            <circle cx="9" cy="9.5" r="1.1" fill="currentColor"></circle>
          </svg>
          {t('风险参考评分', 'Risk reference score')}
        </span>
        <span class={`badge badge--${info.scoreConfidence === 'high' ? 'green' : info.score !== null ? 'amber' : 'gray'}`} data-field="gradeBadge">
          {info.score !== null
            ? `${t('等级', 'Grade')} ${info.grade} · ${
                info.scoreConfidence === 'high'
                  ? t('证据覆盖 高', 'Coverage high')
                  : info.scoreConfidence === 'medium'
                    ? t('证据覆盖 中', 'Coverage medium')
                    : t('证据覆盖 低', 'Coverage low')
              }`
            : info.isBogon ? t('内网保留', 'Reserved') : t('数据源不可达', 'Unavailable')}
        </span>
      </div>

      <div class={`hero-score__main is-${tier.cls}`} data-field="score">
        <span class="hero-score__num mono">{info.score !== null ? info.score : '—'}</span>
        <div class="hero-score__verdict">
          <span class={`hero-score__pill badge badge--solid badge--${tier.badge}`}>{tier.label}</span>
          <p class="hero-score__desc">{tier.desc}</p>
        </div>
      </div>

      <div class="hero-score__skel" aria-hidden="true"></div>

      <!-- 6-Segment Spectrum Bar (0-30-50-68-80-90-99) -->
      <div class="spectrum" data-field="scoreSpectrum" aria-hidden="true" hidden={info.hasThreat === null}>
        <div class="spectrum__bar" data-field="spectrumThumb">
          <span class="spectrum__seg spectrum__seg--1"></span>
          <span class="spectrum__seg spectrum__seg--2"></span>
          <span class="spectrum__seg spectrum__seg--3"></span>
          <span class="spectrum__seg spectrum__seg--4"></span>
          <span class="spectrum__seg spectrum__seg--5"></span>
          <span class="spectrum__seg spectrum__seg--6"></span>
          {info.score !== null && (
            <span class={`spectrum__thumb is-${tier.cls}`} style={`left: ${Math.max(2, Math.min(98, info.score))}%`}></span>
          )}
        </div>
        <div class="spectrum__ticks mono">
          <span style="left:0%">0</span>
          <span style="left:30%">30</span>
          <span style="left:50%">50</span>
          <span style="left:68%">68</span>
          <span style="left:80%">80</span>
          <span style="left:90%">90</span>
          <span style="left:100%">99</span>
        </div>
        <div class="spectrum__labels">
          <span>{t('高风险', 'High')}</span>
          <span>{t('中风险', 'Med')}</span>
          <span>{t('低风险', 'Low')}</span>
          <span>{t('正常', 'OK')}</span>
          <span>{t('纯净', 'Clean')}</span>
          <span>{t('极净', 'Best')}</span>
        </div>
      </div>

      <!-- Concise Deduction / Signal Bullets -->
      <ul class="hero-reasons" data-field="heroReasons">
        {info.isBogon ? (
          <li class="hero-reasons__item is-muted">
            <span class="hero-reasons__dot">·</span>
            <span>{info.bogonReason || t('保留或内网地址，不参与公网纯净度评分', 'Private or reserved range; not scored')}</span>
          </li>
        ) : activeDeductions.length > 0 ? (
          activeDeductions.map((f) => (
            <li class={`hero-reasons__item ${f.key === 'coverage' ? 'is-muted' : 'is-bad'}`}>
              <span class="hero-reasons__dot">{f.key === 'coverage' ? '·' : '×'}</span>
              <span>{f.label}：{f.status}（<span class="mono">{formatDelta(f.delta)}</span>）</span>
            </li>
          ))
        ) : info.score !== null ? (
          <>
            <li class="hero-reasons__item is-good">
              <span class="hero-reasons__dot">✓</span>
              <span>{t('网络类型与注册归属核验正常，无扣分项', 'Network type and RIR origin verified with zero deductions')}</span>
            </li>
            <li class="hero-reasons__item is-good">
              <span class="hero-reasons__dot">✓</span>
              <span>{t(`${info.dnsblTotal} 个 DNSBL 黑名单与威胁库均未命中`, `Clean across all ${info.dnsblTotal} DNSBLs and threat feeds`)}</span>
            </li>
          </>
        ) : (
          <li class="hero-reasons__item is-muted">
            <span class="hero-reasons__dot">·</span>
            <span>{tier.desc}</span>
          </li>
        )}
      </ul>

      <!-- Quick KPI Stat Strip (Authentic factual metrics, zero fake rankings) -->
      <div class="hero-kpis" data-field="heroKpis" hidden={info.isBogon}>
        <div class="hero-kpi">
          <span class="hero-kpi__label">{t('DNSBL 黑名单', 'Blocklists')}</span>
          <span class={`hero-kpi__val mono ${info.dnsblListed.length > 0 ? 'is-bad' : 'is-good'}`}>
            {info.version !== 4 ? 'IPv4' : `${info.dnsblListed.length} / ${info.dnsblTotal}`}
          </span>
        </div>
        <div class="hero-kpi">
          <span class="hero-kpi__label">{t('公网开放端口', 'Open ports')}</span>
          <span class="hero-kpi__val mono">
            {info.version !== 4 ? '—' : !info.portsKnown ? '?' : info.openPorts.length}
          </span>
        </div>
        <div class="hero-kpi">
          <span class="hero-kpi__label">{t('RPKI 路由签名', 'RPKI ROA')}</span>
          <span class={`hero-kpi__val mono ${info.rpkiStatus === 'valid' ? 'is-good' : info.rpkiStatus === 'invalid' ? 'is-bad' : ''}`}>
            {info.rpkiStatus === 'valid' ? 'VALID' : info.rpkiStatus === 'invalid' ? 'INVALID' : '—'}
          </span>
        </div>
      </div>
    </div>

    <!-- Right Column: Real-Time Multi-Source Aggregator Loading Panel + Structured Metadata Rows -->
    <div class="hero-right">
      <div class="agg-loader" data-agg-loader aria-live="polite">
        <div class="agg-loader__head">
          <span class="agg-loader__spinner" aria-hidden="true"></span>
          <span class="agg-loader__title" data-agg-title>
            {t(`正在聚合 ${STREAM_SOURCES.length} 个数据源并计算评分…`, `Aggregating ${STREAM_SOURCES.length} data sources & scoring…`)}
          </span>
          <span class="agg-loader__elapsed mono" data-agg-elapsed>0.0s</span>
        </div>
        <div class="agg-loader__track" aria-hidden="true">
          <span class="agg-loader__bar" data-agg-bar></span>
        </div>
        <div class="agg-loader__chips" data-agg-chips>
          {STREAM_SOURCES.map((src) => (
            <span class="agg-chip" data-agg-source={src.id}>
              <span class="agg-chip__dot" aria-hidden="true"></span>
              <span>{src.label}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="hero-meta" data-hero-meta>
      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('地理位置', 'Location')}</span>
        <span class="hero-meta__val">
          <span data-field="country">
            {info.flagEmoji && <span class="flag">{info.flagEmoji}</span>} <strong>{info.countryZh}</strong>{' '}
            {info.countryCode && <span class="dim mono">{info.countryCode}</span>}
          </span>
          <span class="geo__sep">·</span>
          <span data-field="region">{info.region}</span>
          <span class="geo__sep">/</span>
          <span data-field="city">{info.city}</span>
        </span>
      </div>

      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('ASN 号码', 'ASN')}</span>
        <span class="hero-meta__val">
          <span data-field="asn">
            {info.asn ? (
              <a class="asn-link mono" href={lp(`/whois?q=${info.asnCode}`)} title={lang === 'en' ? `View registration data for ${info.asnCode}` : `查看 ${info.asnCode} 注册信息`}>
                {info.asnCode}
              </a>
            ) : (
              <span class="mono">—</span>
            )}
          </span>
          <span class="dim" data-field="domainSep" hidden={!info.domain || info.domain === '—'}> · </span>
          <span class="mono dim" data-field="domain" hidden={!info.domain || info.domain === '—'}>{info.domain || '—'}</span>
        </span>
      </div>

      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('运营商 (ISP)', 'ISP')}</span>
        <span class="hero-meta__val">
          <span data-field="isp">{info.isp}</span>
        </span>
      </div>

      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('所属机构', 'Organization')}</span>
        <span class="hero-meta__val">
          <span data-field="org">{info.org}</span>{' '}
          <span data-field="datacenter">
            {info.isDatacenter && <span class="badge badge--danger">{t('机房 / IDC', 'IDC / Hosting')}</span>}
          </span>
        </span>
      </div>

      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('注册局与前缀', 'RIR & Prefix')}</span>
        <span class="hero-meta__val" data-field="rirPrefix">
          <span data-field="rirName">{info.rirName}</span>
          {info.rirCountry && <span class="dim mono"> ({info.rirCountry})</span>}
          {info.bgpPrefix && info.bgpPrefix !== '—' && (
            <>
              <span class="dim"> · </span>
              <a class="asn-link mono" href={lp(`/ip-calc?q=${encodeURIComponent(info.bgpPrefix)}`)}>{info.bgpPrefix}</a>
            </>
          )}
        </span>
      </div>

      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('代理与威胁', 'Proxy & Risk')}</span>
        <span class="hero-meta__val tags">
          <span data-field="proxy">
            <span class={`badge badge--${info.isProxy === null ? 'gray' : info.isProxy ? 'amber' : 'green'}`}>{info.proxyLabel}</span>
          </span>
          <span data-field="threat">
            <span class={`badge badge--${info.hasThreat === null ? 'gray' : info.hasThreat ? 'danger' : 'green'}`}>{info.threatLabel}</span>
          </span>
        </span>
      </div>

      <div class="hero-meta__row">
        <span class="hero-meta__label">{t('时区与坐标', 'Time & Coords')}</span>
        <span class="hero-meta__val">
          <span data-field="timezone">
            <span class="mono">{info.timezone}</span>
            {info.localTimeHm && (
              <>
                <span class="dim"> · </span>
                <span class="mono">{info.localTimeHm}</span>
              </>
            )}
          </span>
          <span class="dim"> · </span>
          <span data-field="coords" class="dim">
            <span class="mono">{info.latitude !== null && info.longitude !== null ? `${info.latitude}, ${info.longitude}` : '—'}</span>
          </span>
          <span data-field="continent" hidden>{info.continentZh}</span>
        </span>
      </div>

      <div class="hero-meta__row" data-ptr-row hidden={!info.ptrRecord || info.ptrRecord === '—'}>
