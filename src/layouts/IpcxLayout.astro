---
import { getLang, localePath, splitLocale, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  bodyClass: string;
  currentLabel: string;
  activeNav?: string;
  extraCss?: string[];
  extraJs?: string[];
  wideWrap?: boolean;
  /* 查询结果页设为 true，不进搜索索引 */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  bodyClass,
  currentLabel,
  activeNav = '/',
  extraCss = [],
  extraJs = [],
  wideWrap = true,
  noindex = false,
} = Astro.props;

/* 页面大多带有访客自己的 IP 和请求信息，HTML 一律不进共享缓存 */
if (!Astro.response.headers.has('Cache-Control')) Astro.response.headers.set('Cache-Control', 'private, no-store');
/* 只让工具页和说明页参与收录；查询结果和任何带参数的地址（?ip=、Whois ?q= 等）都不索引 */
const hideFromIndex = noindex || Astro.url.search !== '';
if (hideFromIndex) Astro.response.headers.set('X-Robots-Tag', 'noindex');

// 搜索引擎站长平台验证码：仅在 Cloudflare Workers 运行时变量里配置即生效。
// 不读构建期环境变量，避免本地误设的变量被意外内嵌进部署产物。
let googleVerification = '';
let bingVerification = '';
try {
  const { env } = await import('cloudflare:workers') as unknown as { env: Record<string, string | undefined> };
  googleVerification = env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';
  bingVerification = env.PUBLIC_BING_SITE_VERIFICATION || '';
} catch { /* 非 Workers 环境不输出验证码 */ }

const lang: Lang = getLang(Astro.locals);
const en = lang === 'en';
const t = (zh: string, enText: string) => (en ? enText : zh);
const href = (path: string) => localePath(path, lang);

/* canonicalPath 由各页按中文路径给出；英文页的 canonical 自动挂到 /en 下，两种语言互相用 hreflang 指向 */
const basePath = splitLocale(canonicalPath).path;
const zhUrl = `https://judgeip.com${basePath}`;
const enUrl = `https://judgeip.com${localePath(basePath, 'en')}`;
const canonicalUrl = en ? enUrl : zhUrl;
/* 语言切换保留当前页与查询参数 */
const search = Astro.url.search || '';
const switchHref = (en ? basePath : localePath(basePath, 'en')) + search;

const isLeakActive = ['/webrtc', '/dnsleak', '/fingerprint', '/headers'].includes(activeNav);
const isNetActive = ['/connectivity', '/egress', '/cloudflare', '/cdn', '/split', '/ping'].includes(activeNav);
const isToolsActive = ['/tools', '/platforms', '/compare', '/native-ip', '/residential-ip', '/tiktok-ip', '/whois', '/dns-tools', '/ip-calc', '/card', '/status', '/scoring', '/data', '/api-docs', '/guides', '/asn'].includes(activeNav);

const topNav = [
  { path: '/', label: t('首页', 'Home') },
  { path: '/egress', label: t('我的出口', 'My Egress') },
  { path: '/platforms', label: t('平台检测', 'Platforms') },
  { path: '/claude', label: t('Claude 检测', 'Claude') },
  { path: '/gpt', label: t('GPT 检测', 'GPT') },
  { path: '/check', label: t('环境体检', 'Checkup') },
];

const navGroups = [
  {
    label: t('分流与网络', 'Routing'),
    path: '/split',
    active: isNetActive && activeNav !== '/egress',
    wide: false,
    items: [
      { path: '/split', label: t('网站分流测试', 'Split Routing'), desc: t('34 个主流网站实际出口 IP', 'Actual egress IP across 34 sites') },
      { path: '/connectivity', label: t('网络连通性', 'Connectivity'), desc: t('国内外 44 站可用性与延迟', '44 global & China sites latency') },
      { path: '/cloudflare', label: t('Cloudflare 检测', 'Cloudflare Edge'), desc: t('边缘机房、Turnstile 与 WARP', 'Edge colo, Turnstile & WARP') },
      { path: '/cdn', label: t('CDN 命中节点', 'CDN Nodes'), desc: t('主流 CDN 命中的边缘机房', 'Hit nodes across major CDNs') },
      { path: '/ping', label: t('全球 Ping 测试', 'Global Ping'), desc: t('多地区节点延迟与抖动', 'Multi-region HTTP/TCP RTT') },
    ],
  },
  {
    label: t('泄漏与指纹', 'Leaks'),
    path: '/webrtc',
    active: isLeakActive,
    wide: false,
    items: [
      { path: '/webrtc', label: t('WebRTC 泄漏', 'WebRTC Leak'), desc: t('STUN 候选公网与内网地址', 'STUN candidate public & local IPs') },
      { path: '/dnsleak', label: t('DNS 泄漏检测', 'DNS Leak'), desc: t('递归解析器归属与跨区检查', 'Resolver ownership & region check') },
      { path: '/fingerprint', label: t('浏览器指纹', 'Fingerprint'), desc: t('Canvas / WebGL / TLS 一致性', 'Canvas, WebGL & TLS signals') },
      { path: '/headers', label: t('HTTP 请求头 / UA', 'Headers & UA'), desc: t('边缘收到的原始请求头与代理解析', 'Raw request headers & proxy hints') },
    ],
  },
  {
    label: t('全部功能', 'All Tools'),
    path: '/tools',
    active: isToolsActive && activeNav !== '/platforms',
    wide: true,
    items: [
      { path: '/compare', label: t('多 IP 对比', 'Compare IPs'), desc: t('最多 6 个 IP 并排对比加减分', 'Side-by-side score & factor diff') },
      { path: '/ai', label: t('AI 解锁检测', 'AI Access'), desc: t('ChatGPT / Claude / Gemini 可用性', 'AI service egress & region check') },
      { path: '/native-ip', label: t('原生 IP 检测', 'Native IP'), desc: t('RIR 注册国与定位国对比打分', 'Registry vs geolocation country') },
      { path: '/residential-ip', label: t('住宅 IP 检测', 'Residential IP'), desc: t('住宅 / 移动 / 机房属性核验', 'ISP vs hosting ASN verification') },
      { path: '/tiktok-ip', label: t('TikTok IP 检测', 'TikTok IP'), desc: t('住宅原生权重与设备时区语言比对', 'TikTok weights & browser locale') },
      { path: '/whois', label: t('Whois / RDAP', 'Whois / RDAP'), desc: t('IP 网段、ASN 与域名注册记录', 'Live RIR & domain RDAP lookup') },
      { path: '/dns-tools', label: t('DNS 与黑名单', 'DNS & DNSBL'), desc: t('多记录解析与垃圾邮件黑名单', 'DoH records & spam blocklists') },
      { path: '/ip-calc', label: t('IP 子网计算器', 'CIDR Calculator'), desc: t('IPv4 / IPv6 掩码与地址范围', 'IPv4 / IPv6 netmask & range') },
      { path: '/card', label: t('IP 信息卡', 'IP Share Card'), desc: t('生成可嵌入 SVG / PNG 签名卡片', 'Downloadable SVG & PNG card') },
      { path: '/api-docs', label: t('CLI / API / MCP', 'CLI / API / MCP'), desc: t('免密钥终端报告与 MCP 接入', 'Keyless curl, JSON & MCP server') },
      { path: '/scoring', label: t('评分规则', 'Scoring Rules'), desc: t('公开每一项加减分与判定依据', 'Published points & raw evidence') },
      { path: '/tools', label: t('查看全部工具 ›', 'Browse all tools ›'), desc: t('完整工具目录与数据说明', 'Full directory & data notes') },
    ],
  },
];

const footCols = [
  {
    id: 'foot-detect',
    title: t('核心检测', 'Detection'),
    links: [
      { path: '/', label: t('我的 IP', 'My IP') },
      { path: '/egress', label: t('我的出口', 'My Egress') },
      { path: '/platforms', label: t('平台检测', 'Platform Check') },
      { path: '/check', label: t('环境体检', 'Checkup') },
      { path: '/claude', label: t('Claude 检测', 'Claude Check') },
      { path: '/gpt', label: t('GPT · Codex 检测', 'GPT · Codex') },
      { path: '/ai', label: t('AI 解锁检测', 'AI Access') },
    ],
  },
  {
    id: 'foot-routing',
    title: t('分流与隐私', 'Routing & Privacy'),
    links: [
      { path: '/split', label: t('网站分流测试', 'Split Routing') },
      { path: '/connectivity', label: t('网络连通性', 'Connectivity') },
      { path: '/webrtc', label: t('WebRTC 泄漏', 'WebRTC Leak') },
      { path: '/dnsleak', label: t('DNS 泄漏检测', 'DNS Leak') },
      { path: '/fingerprint', label: t('浏览器指纹', 'Fingerprint') },
      { path: '/cloudflare', label: t('Cloudflare 节点', 'Cloudflare Edge') },
      { path: '/cdn', label: t('CDN 命中节点', 'CDN Nodes') },
    ],
  },
  {
    id: 'foot-tools',
    title: t('查询与对比', 'Lookup & Tools'),
    links: [
      { path: '/compare', label: t('多 IP 对比', 'Compare IPs') },
      { path: '/native-ip', label: t('原生 IP 检测', 'Native IP') },
      { path: '/residential-ip', label: t('住宅 IP 检测', 'Residential IP') },
      { path: '/tiktok-ip', label: t('TikTok IP 检测', 'TikTok IP') },
      { path: '/whois', label: 'Whois / RDAP' },
      { path: '/dns-tools', label: t('DNS / 黑名单', 'DNS & DNSBL') },
      { path: '/ip-calc', label: t('IP 计算器', 'CIDR Calculator') },
      { path: '/ping', label: t('全球 Ping', 'Global Ping') },
      { path: '/card', label: t('IP 信息卡', 'IP Card') },
    ],
  },
  {
    id: 'foot-about',
    title: t('说明与接口', 'Docs & API'),
    links: [
      { path: '/tools', label: t('全部工具', 'All Tools') },
      { path: '/scoring', label: t('评分规则', 'Scoring Rules') },
      { path: '/data', label: t('数据说明', 'Data Sources') },
      { path: '/api-docs', label: t('API 与 MCP', 'API & MCP') },
      { path: '/headers', label: t('HTTP 请求头', 'HTTP Headers') },
      { path: '/status', label: t('服务状态', 'Service Status') },
      { path: '/guides', label: t('深度指南', 'Guides') },
      { path: '/about', label: t('关于本站', 'About') },
      { path: '/contact', label: t('联系我们', 'Contact') },
    ],
  },
];
---

<!doctype html>
<html lang={en ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t('IP查询,IP纯净度检测,本机IP,原生IP,ASN查询,DNS泄露检测,WebRTC泄露,Whois查询,JudgeIP', 'IP lookup,IP reputation,my IP,residential IP,ASN lookup,DNS leak test,WebRTC leak,Whois,JudgeIP')} />
    <meta name="robots" content={hideFromIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <meta name="author" content="JudgeIP" />
    <meta name="color-scheme" content="only light" data-light="only light" data-dark="dark" />
    <meta name="theme-color" content="#f7f8f7" data-light="#f7f8f7" data-dark="#09090b" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JudgeIP" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://judgeip.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={en ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={en ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://judgeip.com/og.png" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="stylesheet" href="/assets/vendor/open-props.min.css" />
    <link rel="stylesheet" href="/assets/vendor/normalize.min.css" />
    <link rel="stylesheet" href="/assets/css/app.css" />
    {extraCss.map((cssHref) => <link rel="stylesheet" href={cssHref} />)}
    <script is:inline src="/assets/js/boot.js"></script>
    <script is:inline src="/assets/js/app.js" defer></script>
    <script is:inline src="/assets/js/spa.js" defer></script>
    {extraJs.map((src) => <script is:inline src={src} defer></script>)}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'JudgeIP',
        url: en ? 'https://judgeip.com/en' : 'https://judgeip.com/',
        description,
        inLanguage: en ? 'en' : 'zh-CN',
      })}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t('跳到正文', 'Skip to content')}</a>

    <header class="navbar" data-navbar>
      <div class="navbar__inner">
        <a class="brand" href={href('/')} aria-label={t('JudgeIP 首页', 'JudgeIP home')}>
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <rect width="32" height="32" rx="8" fill="currentColor" />
              <path
                d="M16 6.8L24.2 10.6V16.8C24.2 21.6 20.7 25.4 16 26.5C11.3 25.4 7.8 21.6 7.8 16.8V10.6L16 6.8Z"
                fill="#fff"
                fill-opacity="0.16"
                stroke="#fff"
                stroke-width="1.7"
                stroke-linejoin="round"
              />
              <path
                d="M17.5 11.6V17.6C17.5 19.4 16.3 20.5 14.4 20.5C13.4 20.5 12.5 20.1 11.9 19.4"
                stroke="#fff"
                stroke-width="2.2"
                stroke-linecap="round"
              />
            </svg>
          </span>
          <span class="brand__word">Judge<span class="brand__accent">IP</span></span>
        </a>

        <span class="navbar__current" aria-hidden="true">{currentLabel}</span>

        <nav class="nav" id="site-nav" aria-label={t('主导航', 'Main navigation')}>
          {topNav.map((item) => (
            <a class={`nav__item${activeNav === item.path ? ' is-active' : ''}`} href={href(item.path)} data-nav-label={item.label} aria-current={activeNav === item.path ? 'page' : undefined}>{item.label}</a>
          ))}

          {navGroups.map((group) => (
            <div class={`nav__group${group.wide ? ' nav__group--wide' : ''}`} data-nav-group>
              <a class={`nav__item nav__item--group${group.active ? ' is-active' : ''}`} href={href(group.path)} aria-haspopup="true" aria-expanded="false" data-nav-group-toggle>
                {group.wide && (
                  <svg class="nav__grid-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="2" y="2" width="4.8" height="4.8" rx="1"></rect>
                    <rect x="9.2" y="2" width="4.8" height="4.8" rx="1"></rect>
                    <rect x="2" y="9.2" width="4.8" height="4.8" rx="1"></rect>
                    <rect x="9.2" y="9.2" width="4.8" height="4.8" rx="1"></rect>
                  </svg>
                )}
                {group.label}
              </a>
              <div class={`nav__sub${group.wide ? ' nav__sub--grid' : ''}`} role="group" aria-label={group.label}>
                {group.items.map((item) => (
                  <a class={`nav__subitem${activeNav === item.path ? ' is-active' : ''}`} href={href(item.path)}>
                    <span class="nav__sublabel">{item.label}</span>
                    {item.desc && <span class="nav__subdesc">{item.desc}</span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>

        <div class="navbar__actions">
          <a class="nav-api-pill" href={href('/api-docs')} title={t('免密钥 CLI / JSON API / MCP 服务', 'Keyless CLI, JSON API & MCP')}>
            <span class="mono">API · MCP</span>
          </a>

          <a class="lang-switch" href={switchHref} hreflang={en ? 'zh-CN' : 'en'} lang={en ? 'zh-CN' : 'en'} title={en ? '切换到中文' : 'Switch to English'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6"></path>
            </svg>
            <span>{en ? '中文' : 'EN'}</span>
          </a>

          <button class="theme-toggle" type="button" data-theme-toggle aria-label={t('切换到深色模式', 'Switch to dark mode')} title={t('切换到深色模式', 'Switch to dark mode')}>
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.2 14.1A8.4 8.4 0 0 1 9.9 3.8a8.4 8.4 0 1 0 10.3 10.3z"></path>
            </svg>
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M5.5 18.5l1.4-1.4M17.1 6.9l1.4-1.4"></path>
            </svg>
          </button>

          <button class="navbar__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label={t('打开导航菜单', 'Open menu')}>
            <svg class="navbar__icon navbar__icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg class="navbar__icon navbar__icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div class={wideWrap ? 'wrap wrap--wide' : 'wrap'}>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <footer class="foot">
      <div class="foot__inner">
        <div class="foot__grid">
          <div class="foot__col foot__col--brand">
            <a class="brand brand--foot" href={href('/')} aria-label={t('JudgeIP 首页', 'JudgeIP home')}>
              <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none">
                  <rect width="32" height="32" rx="8" fill="currentColor" />
                  <path
                    d="M16 6.8L24.2 10.6V16.8C24.2 21.6 20.7 25.4 16 26.5C11.3 25.4 7.8 21.6 7.8 16.8V10.6L16 6.8Z"
                    fill="#fff"
                    fill-opacity="0.16"
                    stroke="#fff"
                    stroke-width="1.7"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M17.5 11.6V17.6C17.5 19.4 16.3 20.5 14.4 20.5C13.4 20.5 12.5 20.1 11.9 19.4"
                    stroke="#fff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
              <span class="brand__word">Judge<span class="brand__accent">IP</span></span>
            </a>
            <p class="foot__about">{t('打开即测、无需注册，查清 IP 纯净度、原始证据、分流与泄露。', 'Instant IP purity, raw evidence, routing and leak checks — no sign-up.')}</p>
            <div class="foot__meta">
              <span class="foot__cli"><span class="dim">$</span> <span class="mono">curl -sL judgeip.com</span></span>
              <span class="foot__contact">hi@judgeip.com</span>
            </div>
          </div>

          {footCols.map((col) => (
            <nav class="foot__col foot__col--products" aria-labelledby={col.id}>
              <h2 class="foot__title" id={col.id}>{col.title}</h2>
              <ul class="foot__list">
                {col.links.map((item) => (
                  <li><a class="foot__link" href={href(item.path)}>{item.label}</a></li>
                ))}
              </ul>
            </nav>
          ))}
        </div>

        <div class="foot__bottom">
          <span>
            © 2026 JudgeIP.com · {t('每项评分均附带可展开核对的上游原始数据', 'Every deduction is backed by verifiable upstream records')}
            <span class="foot__credit">· {t('部分定位数据来自', 'Some geolocation by')} <a href="https://www.ip2location.io" rel="noopener">IP2Location.io</a></span>
          </span>
          <span class="foot__legal">
            <a class="foot__link" href={href('/about')}>{t('关于', 'About')}</a>
            <a class="foot__link" href={href('/contact')}>{t('联系', 'Contact')}</a>
            <a class="foot__link" href={href('/terms')}>{t('服务条款', 'Terms')}</a>
            <a class="foot__link" href={href('/privacy')}>{t('隐私政策', 'Privacy')}</a>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
